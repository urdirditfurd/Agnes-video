// Modèles disponibles en accès anonyme (d'après tests juillet 2026)
const POLLINATIONS_ANONYMOUS_MODELS = [
    'flux', 'turbo', 'gptimage', 'qwen-image', 'grok-imagine',
    'zimage', 'wan-image', 'ideogram-v4-turbo', 'nova-canvas',
    'klein', 'sana', 'p-image'
];

async function generateImageWithPollinations(prompt, retries = 5) {
    // Attente minimale entre 2 appels (rate limit anonyme : 1 req / 15s)
    const now = Date.now();
    const elapsed = now - state.lastPollinationsCall;
    if (elapsed < POLLINATIONS_MIN_INTERVAL_MS && state.lastPollinationsCall > 0) {
        const wait = POLLINATIONS_MIN_INTERVAL_MS - elapsed;
        log('Rate limit : attente ' + Math.ceil(wait / 1000) + 's');
        setStatus('Respect du quota gratuit… (' + Math.ceil(wait / 1000) + 's)');
        await sleep(wait);
    }
    state.lastPollinationsCall = Date.now();

    const encodedPrompt = encodeURIComponent(prompt.slice(0, 1800));

    let lastError = null;

    // Essayer plusieurs modèles anonymes (PAS DE TOKEN dans l'URL)
    for (let attempt = 0; attempt < retries; attempt++) {
        if (state.stopRequested) throw new Error('Arrêt demandé');

        const model = POLLINATIONS_ANONYMOUS_MODELS[attempt % POLLINATIONS_ANONYMOUS_MODELS.length];

        // ⚠️ PAS DE PARAMÈTRE token= DANS L'URL
        const cacheBuster = Date.now() + Math.floor(Math.random() * 10000);
        const url = POLLINATIONS_BASE + encodedPrompt +
            '?width=720&height=1280&model=' + model +
            '&nologo=true&enhance=true&seed=' + state.seed +
            '&_=' + cacheBuster;

        try {
            log('Pollinations [' + model + '] tentative ' + (attempt + 1) + '/' + retries + ' (anonyme)');
            setStatus('Image [' + model + '] tentative ' + (attempt + 1) + '…');

            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), 50000);

            const res = await fetch(url, {
                method: 'GET',
                signal: controller.signal
            });
            clearTimeout(timeoutId);

            if (res.status === 401 || res.status === 402) {
                log('Pollinations [' + model + '] ' + res.status + ' → modèle suivant');
                continue;
            }

            if (res.status === 429) {
                const wait = [20, 40, 60][Math.min(attempt, 2)];
                log('Pollinations [' + model + '] 429 → attente ' + wait + 's');
                await sleep(wait * 1000);
                continue;
            }

            if (res.status >= 500) {
                const wait = [5, 10, 15][Math.min(attempt, 2)];
                log('Pollinations [' + model + '] ' + res.status + ' → attente ' + wait + 's');
                await sleep(wait * 1000);
                continue;
            }

            if (!res.ok) {
                throw new Error('HTTP ' + res.status);
            }

            const blob = await res.blob();
            if (!blob.type.startsWith('image/')) {
                throw new Error('Réponse non-image : ' + blob.type);
            }

            log('✅ Image générée avec ' + model + ' (anonyme)');
            return await new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.onloadend = () => resolve(reader.result);
                reader.onerror = () => reject(new Error('Erreur conversion blob'));
                reader.readAsDataURL(blob);
            });

        } catch (e) {
            if (e.name === 'AbortError') {
                log('Pollinations [' + model + '] timeout 50s');
            } else {
                lastError = e;
                log('Pollinations [' + model + '] tentative ' + (attempt + 1) + ' échouée : ' + e.message);
            }
            if (attempt < retries - 1) {
                await sleep(5000);
                state.lastPollinationsCall = Date.now();
            }
        }
    }

    // Fallback local si tous les modèles échouent
    log('⚠️ Tous les modèles ont échoué — fallback local');
    setStatus('Fallback image de secours…');
    try {
        return await generateFallbackImage(prompt);
    } catch (e) {
        log('Fallback local échoué : ' + e.message);
    }

    throw new Error('Pollinations : ' + (lastError ? lastError.message : 'échec total'));
}

// ══════════════════════════════════════════════════════════════════
// FALLBACK : image de secours générée localement via canvas
// ══════════════════════════════════════════════════════════════════
async function generateFallbackImage(prompt) {
    const canvas = document.createElement('canvas');
    canvas.width = 720;
    canvas.height = 1280;
    const ctx = canvas.getContext('2d');

    const grad = ctx.createLinearGradient(0, 0, 0, 1280);
    grad.addColorStop(0, '#FFE0F0');
    grad.addColorStop(0.5, '#E0F0FF');
    grad.addColorStop(1, '#FFF8E0');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, 720, 1280);

    for (let i = 0; i < 25; i++) {
        ctx.beginPath();
        ctx.arc(
            Math.random() * 720,
            Math.random() * 1280,
            15 + Math.random() * 70,
            0, Math.PI * 2
        );
        ctx.fillStyle = 'rgba(255,255,255,' + (0.15 + Math.random() * 0.35) + ')';
        ctx.fill();
    }

    ctx.font = 'bold 200px sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText('🎨', 360, 500);

    ctx.fillStyle = '#3a2a1a';
    ctx.font = 'bold 36px sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText('Image de secours', 360, 750);

    ctx.font = '24px sans-serif';
    ctx.fillStyle = '#a07a52';
    ctx.fillText('Pollinations était saturé', 360, 810);
    ctx.fillText('Réessayez plus tard', 360, 850);

    return canvas.toDataURL('image/jpeg', 0.85);
}

