<script>
// ══════════════════════════════════════════════════════════════════
// CONFIGURATION
// ══════════════════════════════════════════════════════════════════
const AGNES_API_BASE = 'https://apihub.agnes-ai.com/v1';
const AGNES_POLL_BASE = 'https://apihub.agnes-ai.com/agnesapi';
const POLLINATIONS_BASE = 'https://image.pollinations.ai/prompt/';

const MODEL_VIDEO = 'agnes-video-v2.0';
const FRAME_RATE = 24;

let createIntervalMs = 62000;
const CREATE_INTERVAL_MIN = 62000;
const CREATE_INTERVAL_MAX = 90000;

const POLL_INTERVAL_SEC = 8;
const MAX_POLL_ATTEMPTS = 120;

const AGNES_KEY_STORAGE = 'agnes_api_key';
const WAKE_LOCK_PREF = 'agnes_wakelock_enabled';
const CANONICAL_CHAR_STORAGE = 'kids_story_canonical_character';

const MAX_VISIBLE_QUEUE = 30;
const THUMBNAIL_MAX_WIDTH = 200;

// Délai entre les images (doit être > 15s pour respecter le rate limit anonyme)
const POLLINATIONS_MIN_INTERVAL_MS = 20000;

// ══════════════════════════════════════════════════════════════════
// ÉTAT GLOBAL
// ══════════════════════════════════════════════════════════════════
const state = {
    story: '',
    storySegments: [],
    scenes: [],
    isRunning: false,
    stopRequested: false,
    completed: 0,
    failed: 0,
    selectedTheme: 'pixar-3d',
    characters: 'custom',
    durationFrames: 153,
    targetScenes: 'auto',
    audioFile: null,
    audioObjectUrl: null,
    audioBpm: null,
    audioDuration: 0,
    finalFilmBlob: null,
    isAssembling: false,
    lastPollinationsCall: 0,
    canonicalCharacter: '',
    seed: 42,
    musicVolume: 0.20,
    duckingEnabled: true
};

// ══════════════════════════════════════════════════════════════════
// TOAST
// ══════════════════════════════════════════════════════════════════
let toastTimeout = null;
function showToast(message, type = 'success', duration = 2500) {
    const toast = document.getElementById('toast');
    const icon = document.getElementById('toast-icon');
    const text = document.getElementById('toast-text');
    if (!toast) return;
    toast.classList.remove('visible', 'success', 'error', 'warn');
    void toast.offsetWidth;
    const icons = { success: '✓', error: '✕', warn: '⚠' };
    icon.textContent = icons[type] || '✓';
    text.textContent = message;
    toast.classList.add(type);
    requestAnimationFrame(() => toast.classList.add('visible'));
    if (toastTimeout) clearTimeout(toastTimeout);
    toastTimeout = setTimeout(() => toast.classList.remove('visible'), duration);
}

// ══════════════════════════════════════════════════════════════════
// ANTI-VEILLE
// ══════════════════════════════════════════════════════════════════
let wakeLockSentinel = null;
let wakeLockEnabled = false;
let canvasStream = null;
let canvasInterval = null;

function isWakeLockSupported() {
    return 'wakeLock' in navigator && typeof navigator.wakeLock.request === 'function';
}

async function requestWakeLockAPI() {
    if (!isWakeLockSupported()) return false;
    try {
        wakeLockSentinel = await navigator.wakeLock.request('screen');
        wakeLockSentinel.addEventListener('release', () => {
            wakeLockSentinel = null;
            updateWakeStatus();
        });
        return true;
    } catch (e) { return false; }
}

async function releaseWakeLockAPI() {
    if (wakeLockSentinel) {
        try { await wakeLockSentinel.release(); } catch (e) {}
        wakeLockSentinel = null;
    }
}

function startCanvasStream() {
    if (canvasStream) return true;
    try {
        const canvas = document.getElementById('noSleepCanvas');
        const video = document.getElementById('noSleepVideo');
        if (!canvas || !video) return false;
        const ctx = canvas.getContext('2d');
        if (!ctx) return false;
        ctx.fillStyle = '#000000';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        if (typeof canvas.captureStream !== 'function') return false;
        canvasStream = canvas.captureStream(1);
        let toggle = false;
        canvasInterval = setInterval(() => {
            toggle = !toggle;
            ctx.fillStyle = toggle ? '#000000' : '#010101';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
        }, 1000);
        video.srcObject = canvasStream;
        video.muted = true;
        video.playsInline = true;
        const playPromise = video.play();
        if (playPromise && playPromise.catch) playPromise.catch(e => {});
        return true;
    } catch (e) { return false; }
}

function stopCanvasStream() {
    if (canvasInterval) { clearInterval(canvasInterval); canvasInterval = null; }
    const video = document.getElementById('noSleepVideo');
    if (video) { try { video.pause(); video.srcObject = null; } catch (e) {} }
    if (canvasStream) {
        try { canvasStream.getTracks().forEach(t => t.stop()); } catch (e) {}
        canvasStream = null;
    }
}

async function activateWakeLock() {
    let success = false;
    if (isWakeLockSupported()) success = await requestWakeLockAPI();
    if (!success) success = startCanvasStream();
    if (!success && !canvasStream) success = startCanvasStream();
    return success;
}

async function deactivateWakeLock() {
    await releaseWakeLockAPI();
    stopCanvasStream();
}

function updateWakeStatus() {
    const el = document.getElementById('wake-status');
    const txt = document.getElementById('wake-status-text');
    const btn = document.getElementById('wake-toggle-btn');
    if (!el || !txt || !btn) return;
    el.classList.remove('active', 'warn');
    const hasAny = isWakeLockSupported() || (document.getElementById('noSleepCanvas')?.captureStream);
    if (!hasAny) {
        el.classList.add('warn');
        txt.textContent = '⚠️ Non supporté';
        btn.style.display = 'none';
        return;
    }
    btn.style.display = 'inline-block';
    const isActive = wakeLockSentinel !== null || canvasStream !== null;
    if (wakeLockEnabled && isActive) {
        el.classList.add('active');
        txt.textContent = '✅ Écran allumé';
        btn.textContent = 'Désactiver';
    } else if (wakeLockEnabled && !isActive) {
        el.classList.add('warn');
        txt.textContent = '⏳ En attente';
        btn.textContent = 'Désactiver';
    } else {
        txt.textContent = '💤 Veille automatique';
        btn.textContent = 'Garder l\'écran allumé';
    }
}

async function toggleWakeLock() {
    if (wakeLockEnabled) {
        wakeLockEnabled = false;
        await deactivateWakeLock();
        try { localStorage.setItem(WAKE_LOCK_PREF, '0'); } catch (e) {}
        showToast('Veille réactivée', 'warn');
    } else {
        wakeLockEnabled = true;
        const ok = await activateWakeLock();
        try { localStorage.setItem(WAKE_LOCK_PREF, '1'); } catch (e) {}
        showToast(ok ? 'Écran allumé' : 'Activez manuellement', ok ? 'success' : 'warn');
    }
    updateWakeStatus();
}

document.addEventListener('visibilitychange', async () => {
    if (document.visibilityState === 'visible' && wakeLockEnabled) {
        await activateWakeLock();
        updateWakeStatus();
    }
});

async function ensureWakeLockActive() {
    if (!wakeLockEnabled) return;
    if (wakeLockSentinel === null && canvasStream === null) {
        await activateWakeLock();
        updateWakeStatus();
    }
}

// ══════════════════════════════════════════════════════════════════
// DÉCOUPAGE INTELLIGENT
// ══════════════════════════════════════════════════════════════════
function segmentStory(text, targetScenes) {
    if (!text || !text.trim()) return [];
    let normalized = text.replace(/\*\*/g, '').replace(/\*/g, '').replace(/\s+/g, ' ').trim();
    const sentences = normalized.split(/(?<=[.!?…])\s+/).map(s => s.trim()).filter(s => s.length > 0);
    const MIN_LEN = 40;
    const merged = [];
    let buffer = '';
    for (const s of sentences) {
        buffer = buffer ? buffer + ' ' + s : s;
        if (buffer.length >= MIN_LEN) {
            merged.push(buffer);
            buffer = '';
        }
    }
    if (buffer) {
        if (merged.length > 0) merged[merged.length - 1] += ' ' + buffer;
        else merged.push(buffer);
    }
    const MAX_LEN = 250;
    const finalSegments = [];
    for (const seg of merged) {
        if (seg.length <= MAX_LEN) {
            finalSegments.push(seg);
        } else {
            const parts = seg.split(/[,;]\s+|\s+(?:et|puis|alors|donc|mais|car)\s+/i);
            let sub = '';
            for (const p of parts) {
                sub = sub ? sub + ', ' + p : p;
                if (sub.length >= MAX_LEN * 0.6) {
                    finalSegments.push(sub);
                    sub = '';
                }
            }
            if (sub) {
                if (finalSegments.length > 0) finalSegments[finalSegments.length - 1] += ', ' + sub;
                else finalSegments.push(sub);
            }
        }
    }
    if (targetScenes === 'auto' || !targetScenes) return finalSegments;
    const target = parseInt(targetScenes, 10);
    if (isNaN(target) || target <= 0 || finalSegments.length <= target) return finalSegments;
    const result = [];
    const groupSize = finalSegments.length / target;
    for (let i = 0; i < target; i++) {
        const start = Math.round(i * groupSize);
        const end = Math.round((i + 1) * groupSize);
        const group = finalSegments.slice(start, end).join(' ');
        if (group.trim()) result.push(group.trim());
    }
    return result;
}

// ══════════════════════════════════════════════════════════════════
// EXTRACTION DU PERSONNAGE CANONIQUE
// ══════════════════════════════════════════════════════════════════
function buildCanonicalCharacter(storyText) {
    if (!storyText) return '';
    const lower = storyText.toLowerCase();

    const nameMatch = storyText.match(/(?:prénommé|nommé|appelé|s'appelait)\s+([A-ZÀ-Ý][a-zà-ÿ]+)/);
    const characterName = nameMatch ? nameMatch[1] : '';

    const patterns = [
        { regex: /(dragon)/, base: 'un petit dragon mignon',
          detail: 'aux écailles douces et brillantes, grandes ailes rondes, yeux dorés expressifs et bienveillants, queue ornée d\'une petite flamme dorée' },
        { regex: /(ourson|ours)/, base: 'un adorable ourson en peluche',
          detail: 'avec un pelage duveteux et doux, de grands yeux ronds et brillants, des oreilles rondes, un sourire chaleureux' },
        { regex: /(lapin|lapine|lièvre)/, base: 'une petite lapine adorable',
          detail: 'avec de longues oreilles tombantes toutes douces, un pelage soyeux, de grands yeux pétillants, une petite queue ronde' },
        { regex: /(poussin|poule)/, base: 'un petit poussin tout jaune',
          detail: 'avec un duvet soyeux jaune doré, de grands yeux noirs brillants, un petit bec orange, un chapeau de paille' },
        { regex: /(renard)/, base: 'un petit renard espiègle',
          detail: 'avec une fourrure orange rousse douce, une grande queue touffue, de grands yeux malicieux, des oreilles pointues' },
        { regex: /(licorne)/, base: 'une petite licorne magique',
          detail: 'avec une corne arc-en-ciel scintillante, une crinière multicolore soyeuse, un pelage doux et brillant, des sabots dorés' },
        { regex: /(chaton|chat)/, base: 'un petit chaton mignon',
          detail: 'avec une fourrure soyeuse, de grands yeux ronds expressifs, un petit nez rose, des moustaches fines' },
        { regex: /(chiot|chien)/, base: 'un petit chiot joyeux',
          detail: 'avec un pelage duveteux, de grands yeux brillants, un petit nez humide, une queue remuante' },
        { regex: /(souris|souriceau)/, base: 'une petite souris adorable',
          detail: 'avec de grandes oreilles rondes, un petit nez rose, des yeux perçants, une longue queue fine' },
        { regex: /(hibou|chouette)/, base: 'un petit hibou sage',
          detail: 'avec des plumes douces et soyeuses, de grands yeux ronds dorés, un petit bec crochu' },
        { regex: /(écureuil)/, base: 'un petit écureuil espiègle',
          detail: 'avec une grande queue touffue rousse, des yeux brillants, un petit nez pointu' },
        { regex: /(garçon|petit garçon)/, base: 'un petit garçon joyeux',
          detail: 'avec des cheveux doux, des yeux pétillants, un grand sourire, des vêtements colorés et simples' },
        { regex: /(fille|petite fille)/, base: 'une petite fille joyeuse',
          detail: 'avec des cheveux soyeux, des yeux pétillants, un grand sourire, une robe colorée et simple' }
    ];

    let charBase = '';
    let charDetail = '';

    for (const p of patterns) {
        if (p.regex.test(lower)) {
            charBase = p.base;
            charDetail = p.detail;
            break;
        }
    }

    let colorInfo = '';
    const colorMatch = lower.match(/(bleu|turquoise|rose|jaune|vert|rouge|orange|violet|brun|blanc|noir|gris|doré|argenté)/);
    if (colorMatch) {
        colorInfo = ' de couleur ' + colorMatch[1];
    }

    if (charBase) {
        let description = charBase + colorInfo + ' ' + charDetail;
        if (characterName) {
            description = characterName + ', ' + description;
        }
        description += '. Ce personnage doit être IDENTIQUE dans toutes les scènes : même apparence, même couleur, mêmes proportions, mêmes détails.';
        return description;
    }

    return 'Un personnage principal adorable et attachant, avec de grands yeux expressifs, un sourire chaleureux, un design doux et arrondi style Pixar. Ce personnage doit être IDENTIQUE dans toutes les scènes.';
}

function updateCanonicalCharacter() {
    const story = state.story;
    if (!story) return;
    const canonical = buildCanonicalCharacter(story);
    state.canonicalCharacter = canonical;
