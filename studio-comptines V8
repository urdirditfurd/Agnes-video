async function apiFetch(url, options = {}, label = 'API') {
    for (let attempt = 0; attempt < 7; attempt++) {
        if (state.stopRequested) throw new Error('Arrêt demandé');
        try {
            const res = await fetch(url, options);
            if (res.status === 429) {
                const wait = [15, 30, 45, 60, 90, 120, 180][Math.min(attempt, 6)];
                setStatus('L\'IA se prépare… (' + wait + 's)');
                await sleep(wait * 1000);
                continue;
            }
            if (res.status === 503) {
                const wait = [5, 10, 15, 20, 30, 45][Math.min(attempt, 5)];
                setStatus('Votre scène se prépare… (' + wait + 's)');
                await sleep(wait * 1000);
                continue;
            }
            return res;
        } catch (e) {
            if (e.message === 'Arrêt demandé') throw e;
            const wait = [3, 5, 8, 12, 20, 30][Math.min(attempt, 5)];
            setStatus('Connexion… (' + wait + 's)');
            await sleep(wait * 1000);
        }
    }
    return fetch(url, options);
}

async function createVideoTask(imageDataUri, prompt) {
    const body = {
        model: MODEL_VIDEO,
        prompt: prompt,
        image: imageDataUri,
        num_frames: state.durationFrames,
        frame_rate: FRAME_RATE
    };
    const res = await apiFetch(AGNES_API_BASE + '/videos', {
        method: 'POST',
        headers: {
            'Authorization': 'Bearer ' + getAgnesKey(),
            'Content-Type': 'application/json'
        },
        body: JSON.stringify(body)
    }, 'Création');
    if (!res.ok) {
        const err = await res.text();
        throw new Error('HTTP ' + res.status + ' — ' + err.slice(0, 200));
    }
    const data = await res.json();
    const videoId = data.video_id || data.id || data.task_id;
    if (!videoId) throw new Error('Pas de video_id retourné');
    return videoId;
}

async function pollVideo(videoId, onProgress) {
    const estimatedMs = 30000 + state.durationFrames * 500;
    let remaining = Math.max(20, Math.floor((estimatedMs / 1000) * 0.8));
    while (remaining > 0) {
        if (state.stopRequested) throw new Error('Arrêt demandé');
        onProgress('Préparation… — ' + remaining + 's');
        await sleep(1000);
        remaining--;
    }
    for (let attempt = 0; attempt < MAX_POLL_ATTEMPTS; attempt++) {
        if (state.stopRequested) throw new Error('Arrêt demandé');
        if (attempt > 0) {
            let r = POLL_INTERVAL_SEC;
            while (r > 0) {
                if (state.stopRequested) throw new Error('Arrêt demandé');
                onProgress('L\'image prend vie… — ' + r + 's');
                await sleep(1000);
                r--;
            }
        }
        const url = AGNES_POLL_BASE + '?video_id=' + encodeURIComponent(videoId) + '&model_name=' + encodeURIComponent(MODEL_VIDEO);
        const res = await apiFetch(url, {
            method: 'GET',
            headers: { 'Authorization': 'Bearer ' + getAgnesKey() }
        }, 'Polling');
        const d = await res.json();
        const status = d.status || 'unknown';
        const progress = d.progress || 0;
        onProgress('Création en cours… — ' + progress + '%');
        if (status === 'completed' || status === 'succeeded' || status === 'done') {
            const videoUrl = (d.metadata && d.metadata.url) || d.url || (d.output && d.output.url);
            if (!videoUrl) throw new Error('Terminé mais pas d\'URL');
            return videoUrl;
        }
        if (status === 'failed' || status === 'error' || status === 'cancelled') {
            throw new Error('Échec (' + status + ')');
        }
    }
    throw new Error('Délai maximal dépassé');
}

// ══════════════════════════════════════════════════════════════════
// PIPELINE PRINCIPAL
// ══════════════════════════════════════════════════════════════════
async function generateAllScenes() {
    const scenes = state.storySegments.map((text, i) => ({
        index: i,
        text: text,
        imageDataUri: null,
        thumbnail: null,
        videoUrl: null,
        status: 'pending',
        error: null
    }));

    state.scenes = scenes;
    renderQueue();

    log('═══ ÉTAPE 1 : Images Pollinations anonyme (' + scenes.length + ' scènes) ═══');
    setStatus('Étape 1/2 : génération des images…');

    let previousContext = '';
    for (let i = 0; i < scenes.length; i++) {
        if (state.stopRequested) break;
        const scene = scenes[i];
        scene.status = 'generating-image';
        renderQueue();

        try {
            setStatus('Image ' + (i + 1) + '/' + scenes.length + ' (Pollinations)…');
            const prompt = buildImagePrompt(scene.text, i, scenes.length, previousContext);
            const imageDataUri = await generateImageWithPollinations(prompt, 5);
            scene.imageDataUri = imageDataUri;
            scene.thumbnail = await generateThumbnail(imageDataUri);
            scene.status = 'image-done';
            previousContext = scene.text.slice(0, 150);
            log('[Scène ' + (i + 1) + '] Image ✓');
        } catch (e) {
            log('[Scène ' + (i + 1) + '] Image échouée : ' + e.message);
            scene.status = 'failed';
            scene.error = 'Image: ' + e.message;
            state.failed++;
        }
        renderQueue();
        updateGenerateBtn();
    }

    if (state.stopRequested) return;

    const validScenes = scenes.filter(s => s.imageDataUri && s.status === 'image-done');
    log('═══ ÉTAPE 2 : Vidéos Agnes (' + validScenes.length + ' scènes) ═══');
    setStatus('Étape 2/2 : génération des vidéos…');

    const pollingTasks = [];
    for (let i = 0; i < validScenes.length; i++) {
        if (state.stopRequested) break;
        const scene = validScenes[i];
        scene.status = 'creating';
        renderQueue();

        try {
            setStatus('Vidéo ' + (i + 1) + '/' + validScenes.length + ' (Agnes)…');
            const prompt = buildVideoPrompt(scene.text, scene.index, scenes.length);
            const videoId = await createVideoTask(scene.imageDataUri, prompt);
            scene.videoId = videoId;
            scene.startTime = Date.now();
            scene.status = 'processing';
            renderQueue();
            pollingTasks.push(pollSceneVideo(scene));
        } catch (e) {
            if (e.message === 'Arrêt demandé') break;
            log('[Scène ' + (scene.index + 1) + '] Vidéo échouée : ' + e.message);
            scene.status = 'failed';
            scene.error = 'Vidéo: ' + e.message;
            state.failed++;
            renderQueue();
        }

        if (i < validScenes.length - 1 && !state.stopRequested) {
            const waitSec = Math.ceil(createIntervalMs / 1000);
            for (let r = waitSec; r > 0; r--) {
                if (state.stopRequested) break;
                setStatus('Pause… — vidéo ' + (i + 2) + '/' + validScenes.length + ' dans ' + r + 's');
                await sleep(1000);
            }
        }
    }

    if (pollingTasks.length > 0) {
        setStatus('Finalisation des vidéos…');
        await Promise.allSettled(pollingTasks);
    }
}

async function pollSceneVideo(scene) {
    try {
        const videoUrl = await pollVideo(scene.videoId, (prog) => {
            scene.progress = prog;
            renderQueue();
        });
        scene.status = 'done';
        scene.videoUrl = videoUrl;
        scene.progress = 'Terminé';
        state.completed++;
        renderQueue();
        updateGenerateBtn();
        addToGallery(videoUrl, scene.index + 1);
    } catch (e) {
        if (e.message === 'Arrêt demandé') {
            scene.status = 'failed';
            scene.progress = 'Arrêté';
        } else {
            log('[Scène ' + (scene.index + 1) + '] ' + e.message);
            scene.status = 'failed';
            scene.progress = 'Échec';
            scene.error = 'Vidéo: ' + e.message;
            state.failed++;
        }
        renderQueue();
        updateGenerateBtn();
    }
}

// ══════════════════════════════════════════════════════════════════
// UTILITAIRES AUDIO POUR ASSEMBLAGE (SANS createMediaElementSource)
// ══════════════════════════════════════════════════════════════════

/**
 * Concatène plusieurs AudioBuffers en un seul pour former la piste voix continue.
 */
function concatAudioBuffers(audioCtx, buffers) {
    if (!buffers || buffers.length === 0) return null;
    
    const validBuffers = buffers.filter(b => b && b.length > 0);
    if (validBuffers.length === 0) return null;

    const totalLength = validBuffers.reduce((sum, buf) => sum + buf.length, 0);
    const numberOfChannels = validBuffers[0].numberOfChannels;
    const sampleRate = validBuffers[0].sampleRate;
    
    const result = audioCtx.createBuffer(numberOfChannels, totalLength, sampleRate);
    
    for (let channel = 0; channel < numberOfChannels; channel++) {
        const outputData = result.getChannelData(channel);
        let offset = 0;
        for (const buf of validBuffers) {
            // Gère le cas où un buffer a moins de canaux (ex: mono vers stéréo)
            const channelIndex = channel % buf.numberOfChannels;
            const inputData = buf.getChannelData(channelIndex);
            outputData.set(inputData, offset);
            offset += buf.length;
        }
    }
    return result;
}

/**
 * Mixe la piste voix avec la musique de fond, avec ducking si activé.
 * Traitement sample-par-sample avec limiteur à [-1, 1] pour éviter la saturation.
 */
async function mixAudioWithMusic(audioCtx, voiceBuffer, musicFile, musicVolume, duckingEnabled) {
    if (!musicFile) return voiceBuffer;

    try {
        const musicArrayBuffer = await musicFile.arrayBuffer();
        const musicBuffer = await audioCtx.decodeAudioData(musicArrayBuffer);
        
        const totalSamples = voiceBuffer.length;
        const numberOfChannels = voiceBuffer.numberOfChannels;
        const sampleRate = voiceBuffer.sampleRate;
        const mixedBuffer = audioCtx.createBuffer(numberOfChannels, totalSamples, sampleRate);
        
        const musicLength = musicBuffer.length;
        const musicChannels = musicBuffer.numberOfChannels;
        
        // Seuil simple de détection d'activité vocale (environ -36dB)
        const voiceThreshold = 0.015; 
        const duckingGain = 0.3; // La musique est réduite à 30% de son volume cible quand la voix parle

        for (let channel = 0; channel < numberOfChannels; channel++) {
            const voiceData = voiceBuffer.getChannelData(channel);
            const musicData = musicBuffer.getChannelData(channel % musicChannels);
            const mixedData = mixedBuffer.getChannelData(channel);
            
            for (let i = 0; i < totalSamples; i++) {
                const v = voiceData[i];
                const m = musicData[i % musicLength]; // Loop automatique de la musique
                
                // Détection d'activité vocale sur l'échantillon courant
                const isSpeaking = Math.abs(v) > voiceThreshold;
                const currentMusicVol = (isSpeaking && duckingEnabled) ? musicVolume * duckingGain : musicVolume;
                
                // Mixage et limitation douce (hard clip à [-1, 1])
                let mixed = v + (m * currentMusicVol);
                mixedData[i] = Math.max(-1, Math.min(1, mixed));
            }
        }
        return mixedBuffer;
    } catch (e) {
        log('Échec du mixage musique, utilisation de la voix seule : ' + e.message);
        return voiceBuffer;
    }
}

// ══════════════════════════════════════════════════════════════════
// ASSEMBLAGE — VOIX AGNES + MUSIQUE DUCKING (VERSION ROBUSTE)
// ══════════════════════════════════════════════════════════════════
async function assembleFinalFilm() {
    if (state.isAssembling) return;
    
    const doneScenes = state.scenes
        .filter(s => s.status === 'done' && s.videoUrl)
        .sort((a, b) => a.index - b.index);
        
    if (doneScenes.length === 0) {
        showToast('Aucune scène vidéo à assembler', 'error');
        return;
    }

    state.isAssembling = true;
    state.stopRequested = false; // Réinitialiser pour l'assemblage
    
    const finalFilmEl = document.getElementById('final-film');
    const progressContainer = document.getElementById('assembly-progress');
    const progressFill = document.getElementById('assembly-progress-fill');
    const statusEl = document.getElementById('assembly-status');
    
    finalFilmEl.classList.add('visible');
    progressContainer.style.display = 'block';
    setStatus('Assemblage du film final…');

    let audioCtx = null;
    const videoElements = [];
    const objectUrls = [];

    try {
        // ─── ÉTAPE 1 : Téléchargement (0% - 25%) ───
        statusEl.textContent = 'Téléchargement des scènes…';
        const blobs = [];
        for (let i = 0; i < doneScenes.length; i++) {
            if (state.stopRequested) throw new Error('Assemblage arrêté par l\'utilisateur');
            
            const scene = doneScenes[i];
            progressFill.style.width = ((i / doneScenes.length) * 25) + '%';
            statusEl.textContent = `Téléchargement scène ${i + 1}/${doneScenes.length}…`;
            
            try {
                const res = await fetch(scene.videoUrl);
                if (!res.ok) throw new Error('HTTP ' + res.status);
                const blob = await res.blob();
                blobs.push({ index: scene.index, blob });
            } catch (e) {
                log('Téléchargement scène ' + (scene.index + 1) + ' échoué, skip : ' + e.message);
                // On skippe et on continue avec les scènes valides
            }
        }

        if (blobs.length === 0) throw new Error('Aucune scène n\'a pu être téléchargée');

        // ─── ÉTAPE 2 : Préparation vidéo et extraction audio (25% - 50%) ───
        statusEl.textContent = 'Préparation audio et vidéo…';
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const voiceBuffers = [];

        for (let i = 0; i < blobs.length; i++) {
            if (state.stopRequested) throw new Error('Assemblage arrêté par l\'utilisateur');
            
            progressFill.style.width = (25 + (i / blobs.length) * 25) + '%';
            statusEl.textContent = `Décodage scène ${i + 1}/${blobs.length}…`;
            
            const blob = blobs[i].blob;
            const url = URL.createObjectURL(blob);
            objectUrls.push(url);
            
            const video = document.createElement('video');
            video.src = url;
            video.muted = true; // CRUCIAL : on utilise l'audio extrait, pas celui de l'élément DOM
            video.playsInline = true;
            video.preload = 'auto';
            video.crossOrigin = 'anonymous';

            // Attendre que la vidéo soit prête (readyState >= 3 : HAVE_FUTURE_DATA)
            await new Promise((resolve, reject) => {
                const onReady = () => {
                    if (video.readyState >= 3) {
                        video.removeEventListener('canplaythrough', onReady);
                        resolve();
                    }
                };
                
                if (video.readyState >= 3) {
                    resolve();
                } else {
                    video.addEventListener('canplaythrough', onReady);
                    video.addEventListener('error', () => reject(new Error('Erreur chargement vidéo ' + (i + 1))));
                    setTimeout(() => reject(new Error('Timeout chargement vidéo ' + (i + 1))), 15000);
                }
            });

            videoElements.push({ index: blobs[i].index, video, url });

            // Extraction audio SANS createMediaElementSource (contourne les restrictions CORS)
            try {
                const arrayBuffer = await blob.arrayBuffer();
                const audioBuffer = await audioCtx.decodeAudioData(arrayBuffer);
                voiceBuffers.push(audioBuffer);
            } catch (e) {
                log('Échec extraction audio scène ' + (i + 1) + ' : ' + e.message);
                // Créer un buffer vide de même durée pour maintenir la synchronisation temporelle
                const duration = video.duration || 5;
                const emptyBuffer = audioCtx.createBuffer(
                    2, 
                    Math.floor(duration * audioCtx.sampleRate), 
                    audioCtx.sampleRate
                );
                voiceBuffers.push(emptyBuffer);
            }
        }

        if (videoElements.length === 0) throw new Error('Aucune vidéo n\'a pu être décodée');

        // ─── ÉTAPE 3 : Concaténation et Mixage (50% - 75%) ───
        statusEl.textContent = 'Mixage audio…';
        progressFill.style.width = '50%';
        
        const concatenatedVoice = concatAudioBuffers(audioCtx, voiceBuffers);
        if (!concatenatedVoice) throw new Error('Échec de la concaténation audio');

        const finalAudioBuffer = await mixAudioWithMusic(
            audioCtx, 
            concatenatedVoice, 
            state.audioFile, 
            state.musicVolume, 
            state.duckingEnabled
        );

        // ─── ÉTAPE 4 : Configuration de l'enregistrement (75%) ───
        statusEl.textContent = 'Initialisation de l\'enregistrement…';
        progressFill.style.width = '75%';

        const firstVideo = videoElements[0].video;
        const width = firstVideo.videoWidth || 720;
        const height = firstVideo.videoHeight || 1280;
        log(`Dimensions du film : ${width}x${height}`);

        const canvas = document.createElement('canvas');
        canvas.width = width;
        canvas.height = height;
        const ctx = canvas.getContext('2d');
        
        // Fond noir initial pour éviter les frames transparentes au démarrage
        ctx.fillStyle = '#000000';
        ctx.fillRect(0, 0, width, height);

        const canvasStream = canvas.captureStream(30); // 30 FPS

        const audioDestination = audioCtx.createMediaStreamDestination();
        const audioSource = audioCtx.createBufferSource();
        audioSource.buffer = finalAudioBuffer;
        audioSource.connect(audioDestination);

        const combinedStream = new MediaStream([
            ...canvasStream.getVideoTracks(),
            ...audioDestination.stream.getAudioTracks()
        ]);

        const mimeTypes = [
            'video/webm;codecs=vp9,opus',
            'video/webm;codecs=vp8,opus',
            'video/webm'
        ];
        const mimeType = mimeTypes.find(mt => MediaRecorder.isTypeSupported(mt)) || 'video/webm';
        log('Codec MediaRecorder utilisé : ' + mimeType);

        const recorder = new MediaRecorder(combinedStream, {
            mimeType: mimeType,
            videoBitsPerSecond: 4000000,
            audioBitsPerSecond: 128000
        });

        const chunks = [];
        recorder.ondataavailable = (e) => {
            if (e.data && e.data.size > 0) chunks.push(e.data);
        };

        const recordingDone = new Promise((resolve) => {
            recorder.onstop = () => {
                resolve(new Blob(chunks, { type: mimeType }));
            };
        });

        // ─── ÉTAPE 5 : Rendu séquentiel (75% - 100%) ───
        statusEl.textContent = 'Enregistrement en cours…';
        recorder.start(1000); // Collecter les données chaque seconde pour éviter la perte en mémoire
        audioSource.start(0);

        let currentVideoIndex = 0;
        // Éviter la division par zéro si les durées sont indéterminées
        const totalDuration = Math.max(1, videoElements.reduce((sum, v) => sum + (v.video.duration || 0), 0));

        const renderLoop = () => {
            if (state.stopRequested) {
                recorder.stop();
                return;
            }

            if (currentVideoIndex < videoElements.length) {
                const { video } = videoElements[currentVideoIndex];

                if (video.readyState >= 3) {
                    // S'assurer que la vidéo joue (gestion des pauses inattendues)
                    if (video.paused && !video.ended) {
                        video.play().catch(e => log('Erreur play vidéo: ' + e.message));
                    }

                    if (!video.paused) {
                        ctx.drawImage(video, 0, 0, width, height);

                        // Vérifier si on arrive à la fin de la scène courante (marge de 0.05s)
                        if (video.currentTime >= (video.duration || 0) - 0.05 || video.ended) {
                            currentVideoIndex++;
                            if (currentVideoIndex < videoElements.length) {
                                const nextVideo = videoElements[currentVideoIndex].video;
                                nextVideo.currentTime = 0;
                                // Petit délai pour assurer une transition fluide entre les scènes
                                setTimeout(() => {
                                    nextVideo.play().catch(e => log('Erreur play vidéo suivante: ' + e.message));
                                    requestAnimationFrame(renderLoop);
                                }, 50);
                                return; // Sortir pour reprendre au prochain frame après le play
                            } else {
                                // Toutes les vidéos sont terminées
                                recorder.stop();
                                return;
                            }
                        }

                        // Mise à jour de la progression (75% à 100%)
                        let elapsed = 0;
                        for (let i = 0; i < currentVideoIndex; i++) {
                            elapsed += videoElements[i].video.duration || 0;
                        }
                        elapsed += video.currentTime;
                        const percent = 75 + (elapsed / totalDuration) * 25;
                        progressFill.style.width = Math.min(percent, 100) + '%';
                        statusEl.textContent = `Enregistrement scène ${currentVideoIndex + 1}/${videoElements.length}…`;
                    }
                    requestAnimationFrame(renderLoop);
                } else {
                    // Si la vidéo n'est pas prête, on réessaie au prochain frame
                    requestAnimationFrame(renderLoop);
                }
            }
        };

        // Démarrer la première vidéo pour lancer la boucle de rendu
        if (videoElements.length > 0) {
            videoElements[0].video.currentTime = 0;
            await videoElements[0].video.play().catch(e => log('Erreur play première vidéo: ' + e.message));
            requestAnimationFrame(renderLoop);
        }

        // ─── ÉTAPE 6 : Finalisation ───
        const finalBlob = await recordingDone;
        state.finalFilmBlob = finalBlob;

        const finalVideo = document.getElementById('final-video');
        const finalUrl = URL.createObjectURL(finalBlob);
        finalVideo.src = finalUrl;

        document.getElementById('download-btn').classList.add('visible');

        progressFill.style.width = '100%';
        statusEl.textContent = `✅ Film prêt ! Taille : ${(finalBlob.size / 1024 / 1024).toFixed(1)} Mo`;
        setStatus(null);
        showToast('Film assemblé avec voix + musique ✓', 'success');

    } catch (e) {
        log('Erreur assemblage : ' + e.message);
        statusEl.textContent = '❌ Erreur : ' + e.message;
        showToast('Erreur assemblage : ' + e.message, 'error', 5000);
    } finally {
        state.isAssembling = false;
        setStatus(null);
        
        // Nettoyage systématique des URLs objet pour éviter les fuites mémoire
        objectUrls.forEach(url => {
            try { URL.revokeObjectURL(url); } catch (e) {}
        });
        
        // Fermeture systématique de l'AudioContext dans un bloc finally
        if (audioCtx && audioCtx.state !== 'closed') {
            try { 
                await audioCtx.close(); 
            } catch (e) {
                log('Erreur fermeture AudioContext : ' + e.message);
            }
        }
    }
}

function downloadFinalFilm() {
    if (!state.finalFilmBlob) {
        showToast('Aucun film à télécharger', 'error');
        return;
    }
    const url = URL.createObjectURL(state.finalFilmBlob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'kids-story-film-' + Date.now() + '.webm';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    setTimeout(() => URL.revokeObjectURL(url), 30000);
    showToast('Téléchargement lancé ✓', 'success');
}

// ══════════════════════════════════════════════════════════════════
// AUDIO
// ══════════════════════════════════════════════════════════════════
async function detectBPM(file) {
    try {
        const arrayBuffer = await file.arrayBuffer();
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const audioBuffer = await audioCtx.decodeAudioData(arrayBuffer);
        const channelData = audioBuffer.getChannelData(0);
        const sampleRate = audioBuffer.sampleRate;
        const peaks = [];
        const threshold = 0.3;
        const minPeakDistance = Math.floor(sampleRate * 0.1);
        for (let i = 0; i < channelData.length; i++) {
            if (Math.abs(channelData[i]) > threshold) {
                if (peaks.length === 0 || (i - peaks[peaks.length - 1]) > minPeakDistance) {
                    peaks.push(i);
                }
            }
        }
        if (peaks.length < 2) { audioCtx.close(); return null; }
        let totalInterval = 0;
        for (let i = 1; i < peaks.length; i++) totalInterval += (peaks[i] - peaks[i - 1]);
        const avgInterval = totalInterval / (peaks.length - 1);
        const bpm = Math.round(60 / (avgInterval / sampleRate));
        audioCtx.close();
        return bpm > 0 && bpm < 300 ? bpm : null;
    } catch (e) { return null; }
}

function displayBPM(bpm) {
    const el = document.getElementById('bpm-display');
    const valEl = document.getElementById('bpm-value');
    const msgEl = document.getElementById('bpm-message');
    if (!el) return;
    el.classList.add('visible');
    el.classList.remove('ok', 'warn');
    if (bpm === null) {
        valEl.textContent = '—';
        msgEl.textContent = '⚠️ Analyse impossible';
        el.classList.add('warn');
        return;
    }
    valEl.textContent = bpm;
    if (bpm >= 90 && bpm <= 120) {
        el.classList.add('ok');
        msgEl.textContent = '✅ Tempo idéal pour les tout-petits';
    } else {
        el.classList.add('warn');
        msgEl.textContent = '⚠️ Idéal : 100-110 BPM';
    }
}

async function handleAudioFile(file) {
    if (!file || !file.type.startsWith('audio/')) {
        showToast('Fichier audio invalide', 'error');
        return;
    }
    if (state.audioObjectUrl) URL.revokeObjectURL(state.audioObjectUrl);
    state.audioFile = file;
    state.audioObjectUrl = URL.createObjectURL(file);

    const audioZone = document.getElementById('audio-zone');
    const filenameEl = document.getElementById('audio-filename');
    const previewEl = document.getElementById('audio-preview');
    const removeBtn = document.getElementById('audio-remove-btn');

    audioZone.classList.add('has-file');
    filenameEl.textContent = '🎵 ' + file.name;
    filenameEl.style.display = 'block';
    previewEl.src = state.audioObjectUrl;
    previewEl.style.display = 'block';
    removeBtn.style.display = 'inline-block';

    previewEl.onloadedmetadata = () => { state.audioDuration = previewEl.duration; };

    showToast('Analyse du tempo…', 'warn', 1500);
    const bpm = await detectBPM(file);
    state.audioBpm = bpm;
    displayBPM(bpm);
    showToast('Musique ajoutée ✓', 'success');
}

function removeAudioFile() {
    if (state.audioObjectUrl) URL.revokeObjectURL(state.audioObjectUrl);
    state.audioFile = null;
    state.audioObjectUrl = null;
    state.audioBpm = null;
    state.audioDuration = 0;

    const audioZone = document.getElementById('audio-zone');
    const filenameEl = document.getElementById('audio-filename');
    const previewEl = document.getElementById('audio-preview');
    const removeBtn = document.getElementById('audio-remove-btn');
    const bpmEl = document.getElementById('bpm-display');

    audioZone.classList.remove('has-file');
    filenameEl.style.display = 'none';
    previewEl.src = '';
    previewEl.style.display = 'none';
    removeBtn.style.display = 'none';
    if (bpmEl) bpmEl.classList.remove('visible');
    showToast('Musique retirée', 'warn');
}

