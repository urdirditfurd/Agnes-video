            '<div class="style-emoji">' + s.emoji + '</div>' +
            '<div>' +
                '<div class="style-name">' + esc(s.name) + '</div>' +
                '<div class="style-desc">' + esc(s.desc) + '</div>' +
            '</div>' +
        '</div>';
    }).join('');
    container.querySelectorAll('[data-theme]').forEach(el => {
        el.addEventListener('click', () => {
            state.selectedTheme = el.dataset.theme;
            renderStyles();
        });
    });
}

function renderQueue() {
    const queueEl = document.getElementById('queue');
    if (!state.scenes.length) { queueEl.style.display = 'none'; return; }
    queueEl.style.display = 'block';

    const total = state.scenes.length;
    const done = state.scenes.filter(s => s.status === 'done').length;
    const failed = state.scenes.filter(s => s.status === 'failed').length;

    let html = '<div class="queue-summary">' +
        '<span class="progress-text">Progression : ' + done + '/' + total + ' scènes</span>' +
        '<span class="eta-text">' + (failed > 0 ? '⚠️ ' + failed + ' échec(s)' : '') + '</span>' +
        '</div>';

    const visible = state.scenes.slice(0, MAX_VISIBLE_QUEUE);
    html += visible.map(scene => {
        let icon = '○', statusText = 'En attente', cls = 'pending';
        if (scene.status === 'generating-image') { icon = '🎨'; statusText = 'Image gratuite…'; cls = 'generating-image'; }
        else if (scene.status === 'image-done') { icon = '✓'; statusText = 'Image prête'; cls = 'pending'; }
        else if (scene.status === 'creating') { icon = '◐'; statusText = 'Création vidéo…'; cls = 'creating'; }
        else if (scene.status === 'processing') { icon = '◐'; statusText = scene.progress || 'Vidéo…'; cls = 'processing'; }
        else if (scene.status === 'done') { icon = '🌟'; statusText = 'Terminé'; cls = 'done'; }
        else if (scene.status === 'failed') { icon = '✕'; statusText = 'Échec'; cls = 'failed'; }

        const thumbHTML = scene.thumbnail
            ? '<div class="q-thumb"><img src="' + scene.thumbnail + '" alt=""></div>'
            : '<div class="q-thumb"></div>';

        return '<div class="queue-item ' + cls + '">' +
            '<div class="q-icon">' + icon + '</div>' +
            thumbHTML +
            '<div class="q-info">' +
                '<div class="q-name">Scène ' + (scene.index + 1) + '</div>' +
                '<div class="q-excerpt">' + esc(scene.text.slice(0, 80)) + '…</div>' +
            '</div>' +
            '<div class="q-status">' + esc(statusText) + '</div>' +
        '</div>';
    }).join('');
    queueEl.innerHTML = html;
}

function addToGallery(videoUrl, sceneNumber) {
    const galleryEl = document.getElementById('gallery');
    const galleryGrid = document.getElementById('gallery-grid');
    galleryEl.style.display = 'block';
    const el = document.createElement('div');
    el.className = 'gallery-item';
    el.innerHTML = '<video controls preload="metadata" muted playsinline>' +
        '<source src="' + videoUrl + '" type="video/mp4">' +
        '</video>' +
        '<div class="g-caption">🎬 Scène ' + sceneNumber + '</div>';
    galleryGrid.appendChild(el);
}

// ══════════════════════════════════════════════════════════════════
// MÉTADONNÉES YOUTUBE
// ══════════════════════════════════════════════════════════════════
function generateYouTubeMetadata() {
    const theme = JOYFUL_THEMES.find(t => t.id === state.selectedTheme);
    const themeEmoji = theme ? theme.emoji : '✨';
    const title = themeEmoji + ' Histoire Animée pour Enfants | Conte 3D Joyeux pour Bébés';
    const description = themeEmoji + ' Bienvenue dans un monde joyeux et coloré !\n\n' +
        state.story.slice(0, 400) + (state.story.length > 400 ? '…' : '') + '\n\n' +
        '✨ Une histoire animée 3D Pixar, joyeuse et 100% sécurisée pour les enfants.\n' +
        '✅ COPPA compliant — contenu pour enfants\n' +
        '✅ Aucune violence, aucun contenu effrayant\n' +
        '🎵 Musique libre de droit\n\n' +
        '#Shorts #ShortsEnfants #VidéoEnfant #DessinAnimé #Conte #Histoire #Bébé #ToutPetit #Joyeux #COPPA';
    const tags = 'shorts, shorts enfants, vidéo enfant, dessin animé, animation 3D, conte, histoire enfant, histoire du soir, comptine, chanson bébé, COPPA, YouTube Kids, tout-petit, bébé, enfant, pixar, kids video, children animation, kids story, bedtime story, safe for kids, toddler video, nursery rhymes';
    return { title, description, tags };
}

function displayYouTubeMetadata() {
    const meta = generateYouTubeMetadata();
    document.getElementById('meta-title').value = meta.title;
    document.getElementById('meta-description').value = meta.description;
    document.getElementById('meta-tags').value = meta.tags;
    document.getElementById('meta-panel').style.display = 'block';
}

// ══════════════════════════════════════════════════════════════════
// WORKFLOW PRINCIPAL
// ══════════════════════════════════════════════════════════════════
async function startGeneration() {
    if (state.isRunning || !state.storySegments.length) return;
    if (!getAgnesKey()) {
        showToast('Ajoutez votre clé Agnes', 'error');
        return;
    }

    const canonicalEl = document.getElementById('canonical-character');
    if (canonicalEl && canonicalEl.value.trim()) {
        state.canonicalCharacter = canonicalEl.value.trim();
    }

    state.isRunning = true;
    state.stopRequested = false;
    state.completed = 0;
    state.failed = 0;
    state.scenes = [];
    state.finalFilmBlob = null;
    state.lastPollinationsCall = 0;
    state.seed = parseInt(document.getElementById('seed-input').value, 10) || 42;
    createIntervalMs = CREATE_INTERVAL_MIN;

    document.getElementById('gallery-grid').innerHTML = '';
    document.getElementById('gallery').style.display = 'none';
    document.getElementById('final-film').classList.remove('visible');
    document.getElementById('assemble-btn').classList.remove('visible');
    document.getElementById('download-btn').classList.remove('visible');
    document.getElementById('stop-btn').classList.add('visible');
    document.getElementById('generate-btn').disabled = true;
    document.getElementById('meta-panel').style.display = 'none';

    await ensureWakeLockActive();
    log('═══ DÉMARRAGE ═══');
    log('Personnage canonique : ' + state.canonicalCharacter.slice(0, 100) + '…');
    log('Seed : ' + state.seed);
    log('Mode Pollinations : accès anonyme direct (sans token)');

    try {
        await generateAllScenes();
    } catch (e) {
        log('Erreur : ' + e.message);
    }

    const doneScenes = state.scenes.filter(s => s.status === 'done').length;
    const failedScenes = state.scenes.filter(s => s.status === 'failed').length;

    state.isRunning = false;
    state.stopRequested = false;
    document.getElementById('stop-btn').classList.remove('visible');
    updateGenerateBtn();

    const summary = doneScenes + '/' + state.scenes.length + ' scènes réussies' +
        (failedScenes > 0 ? ' (' + failedScenes + ' échec(s))' : '');
    setStatus(summary);
    await sleep(3000);
    setStatus(null);

    if (doneScenes > 0) {
        document.getElementById('assemble-btn').classList.add('visible');
        displayYouTubeMetadata();
        showToast(doneScenes + ' scène' + (doneScenes > 1 ? 's' : '') + ' prête' + (doneScenes > 1 ? 's' : ''), 'success');
    } else {
        showToast('Aucune scène générée', 'error');
    }
}

function stopGeneration() {
    if (!state.isRunning && !state.isAssembling) return;
    state.stopRequested = true;
    setStatus('Arrêt en cours…');
}

// ══════════════════════════════════════════════════════════════════
// DIAGNOSTIC
// ══════════════════════════════════════════════════════════════════
async function runDiagnostic() {
    const out = document.getElementById('diag-output');
    out.style.display = 'block';
    out.textContent = '⏳ Diagnostic en cours...\n\n';
    const logLine = (msg) => { out.textContent += msg + '\n'; };

    logLine('═══ TEST POLLINATIONS.AI (accès anonyme) ═══');
    logLine('Mode : SANS token (accès direct)');
    logLine('');

    for (const model of POLLINATIONS_ANONYMOUS_MODELS.slice(0, 6)) {
        try {
            const testPrompt = encodeURIComponent('a cute friendly cartoon teddy bear, colorful, children illustration');
            const testUrl = POLLINATIONS_BASE + testPrompt + '?width=720&height=1280&model=' + model + '&nologo=true&seed=42';
            const start = Date.now();
            const res = await fetch(testUrl);
            const elapsed = ((Date.now() - start) / 1000).toFixed(1);
            if (res.ok) {
                const blob = await res.blob();
                if (blob.type.startsWith('image/')) {
                    logLine('✅ ' + model + ' — HTTP 200 (' + elapsed + 's, ' + (blob.size / 1024).toFixed(0) + ' Ko)');
                } else {
                    logLine('⚠️ ' + model + ' — réponse non-image');
                }
            } else {
                logLine('❌ ' + model + ' — HTTP ' + res.status);
            }
        } catch (e) {
            logLine('❌ ' + model + ' — Réseau : ' + e.message);
        }
    }

    logLine('\n═══ TEST AGNES (vidéos + voix) ═══');
    const agnesKey = getAgnesKey();
    logLine('Clé : ' + (agnesKey ? agnesKey.slice(0, 12) + '…' + agnesKey.slice(-6) : '(vide)'));
    if (agnesKey) {
        try {
            const res = await fetch('https://apihub.agnes-ai.com/v1/models', {
                headers: { 'Authorization': 'Bearer ' + agnesKey }
            });
            logLine('HTTP ' + res.status);
            if (res.ok) logLine('✅ Agnes OK (voix et vidéos)');
            else {
                const t = await res.text();
                logLine('❌ ' + t.slice(0, 200));
            }
        } catch (e) {
            logLine('❌ Réseau : ' + e.message);
        }
    } else {
        logLine('⚠️ Aucune clé Agnes');
    }

    logLine('\n═══ FIN ═══');
}

// ══════════════════════════════════════════════════════════════════
// INITIALISATION
// ══════════════════════════════════════════════════════════════════
(function init() {
    document.getElementById('api-save-btn')?.addEventListener('click', saveAgnesKey);
    document.getElementById('stop-btn')?.addEventListener('click', stopGeneration);
    document.getElementById('assemble-btn')?.addEventListener('click', assembleFinalFilm);
    document.getElementById('download-btn')?.addEventListener('click', downloadFinalFilm);
    document.getElementById('diag-btn')?.addEventListener('click', runDiagnostic);

    document.querySelectorAll('[data-toggle]').forEach(header => {
        header.addEventListener('click', () => {
            document.getElementById(header.dataset.toggle).classList.toggle('open');
        });
    });

    document.getElementById('main-prompt')?.addEventListener('input', updateStoryPreview);
    document.getElementById('scenes-count-select')?.addEventListener('change', updateStoryPreview);
    document.getElementById('duration-select')?.addEventListener('change', e => {
        state.durationFrames = parseInt(e.target.value, 10);
    });
    document.getElementById('characters-select')?.addEventListener('change', e => {
        state.characters = e.target.value;
        if (e.target.value !== 'custom') {
            state.canonicalCharacter = CHARACTER_PROMPTS[e.target.value] || '';
            const ta = document.getElementById('canonical-character');
            if (ta) ta.value = state.canonicalCharacter;
        } else {
            updateCanonicalCharacter();
        }
    });
    document.getElementById('seed-input')?.addEventListener('change', e => {
        state.seed = parseInt(e.target.value, 10) || 42;
    });

    document.getElementById('canonical-character')?.addEventListener('input', e => {
        state.canonicalCharacter = e.target.value;
        try { localStorage.setItem(CANONICAL_CHAR_STORAGE, e.target.value); } catch (err) {}
    });

    document.getElementById('music-volume')?.addEventListener('input', e => {
        state.musicVolume = parseInt(e.target.value, 10) / 100;
        document.getElementById('music-volume-value').textContent = e.target.value + '%';
    });
    document.getElementById('duck-toggle')?.addEventListener('change', e => {
        state.duckingEnabled = e.target.checked;
    });

    const audioZone = document.getElementById('audio-zone');
    const audioInput = document.getElementById('audio-input');
    if (audioZone && audioInput) {
        audioZone.addEventListener('click', (e) => {
            if (e.target.tagName === 'AUDIO' || e.target.tagName === 'BUTTON' || e.target.tagName === 'INPUT') return;
            audioInput.click();
        });
        audioInput.addEventListener('change', e => {
            if (e.target.files && e.target.files[0]) handleAudioFile(e.target.files[0]);
            audioInput.value = '';
        });
    }
    document.getElementById('audio-remove-btn')?.addEventListener('click', (e) => {
        e.stopPropagation();
        removeAudioFile();
    });

    document.getElementById('generate-btn')?.addEventListener('click', startGeneration);
    document.getElementById('wake-toggle-btn')?.addEventListener('click', toggleWakeLock);

    try {
        wakeLockEnabled = localStorage.getItem(WAKE_LOCK_PREF) === '1';
        const savedChar = localStorage.getItem(CANONICAL_CHAR_STORAGE);
        if (savedChar) {
            state.canonicalCharacter = savedChar;
            const ta = document.getElementById('canonical-character');
            if (ta) ta.value = savedChar;
        }
    } catch (e) {}

    if (wakeLockEnabled) activateWakeLock().then(updateWakeStatus);

    document.getElementById('meta-copy-btn')?.addEventListener('click', () => {
        const text = 'TITRE :\n' + document.getElementById('meta-title').value +
            '\n\nDESCRIPTION :\n' + document.getElementById('meta-description').value +
            '\n\nTAGS :\n' + document.getElementById('meta-tags').value;
        navigator.clipboard.writeText(text).then(() => showToast('Copié ✓', 'success'));
    });

    updateApiPanel();
    updateWakeStatus();
    renderStoryPresets();
    renderStyles();
    renderQueue();
    updateStoryPreview();
    log('Kids Story Studio prêt (accès anonyme direct sans token)');
})();
</script>

