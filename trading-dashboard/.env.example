# =============================================================================
# Trading Dashboard — variables d'environnement (NE PAS COMMITTER .env)
# Copier vers .env et renseigner les valeurs réelles avant déploiement.
# =============================================================================

# --- Domaine & SSL (Let's Encrypt exige un nom de domaine, pas une IP seule) ---
DOMAIN=trading.votredomaine.com
CERTBOT_EMAIL=admin@votredomaine.com
# true = staging Let's Encrypt (tests), false = prod
CERTBOT_STAGING=false

# --- PostgreSQL ---
POSTGRES_USER=trading
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=trading_bot
DATABASE_URL=postgresql+asyncpg://trading:CHANGE_ME_strong_db_password@postgres:5432/trading_bot

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Sécurité application ---
# Générer avec: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=CHANGE_ME_generate_fernet_key
# Générer avec: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
# Mot de passe admin du dashboard (hashé côté backend au premier boot recommandé)
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=https://trading.votredomaine.com

# --- Binance (laisser vide ici ; préférer la saisie chiffrée via le dashboard) ---
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
BINANCE_TESTNET=true

# --- Bot (valeurs par défaut ; surchargeables via Settings DB) ---
DEFAULT_SYMBOL=BTC/USDT
DEFAULT_TIMEFRAME=15m
DEFAULT_TRADE_SIZE_USD=200
DEFAULT_RSI_PERIOD=14
DEFAULT_RSI_THRESHOLD=30
DEFAULT_BB_PERIOD=20
DEFAULT_BB_STD=2.0
DEFAULT_STOP_LOSS_PCT=2.0
DEFAULT_TAKE_PROFIT_PCT=5.0

# --- Services ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
LOG_LEVEL=INFO
TZ=Europe/Paris
