# =============================================================================
# Trading Dashboard — variables d'environnement (NE PAS COMMITTER .env)
#
# Démarrage rapide VPS SANS domaine :
#   bash scripts/setup-env.sh --no-ssl
#   bash deploy.sh --no-ssl
# =============================================================================

# --- Accès / SSL ---
# --no-ssl : DOMAIN peut être l'IP publique (ex: 51.254.135.158)
# --full   : DOMAIN = vrai hostname DNS A → IP VPS
DOMAIN=51.254.135.158
CERTBOT_EMAIL=admin@localhost
CERTBOT_STAGING=false
ENABLE_SSL=false

# --- PostgreSQL ---
POSTGRES_USER=trading
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=trading_bot
DATABASE_URL=postgresql+asyncpg://trading:CHANGE_ME_strong_db_password@postgres:5432/trading_bot

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Sécurité application ---
FERNET_KEY=CHANGE_ME_generate_fernet_key
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password
JWT_EXPIRE_MINUTES=1440
# * pour mode IP/HTTP ; URL https://domaine pour SSL
CORS_ORIGINS=*

# --- Binance ---
BINANCE_TESTNET=true

# --- Bot defaults (surchargeables via table settings) ---
DEFAULT_SYMBOL=BTC/USDT
DEFAULT_TIMEFRAME=15m
DEFAULT_TRADE_SIZE_USD=200
DEFAULT_RSI_PERIOD=14
DEFAULT_RSI_THRESHOLD=30
DEFAULT_BB_PERIOD=20
DEFAULT_BB_STD=2.0
DEFAULT_STOP_LOSS_PCT=2.0
DEFAULT_TAKE_PROFIT_PCT=5.0

# --- Services ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
LOG_LEVEL=INFO
TZ=Europe/Paris
