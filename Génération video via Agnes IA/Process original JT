async function pollVideo(videoId,onProgress){const estimatedMs=estimateGenerationTime('video',90000+state.durationSeconds*7000);const minWait=Math.max(25,Math.min(VIDEO_FIRST_POLL_DELAY_SEC,Math.floor(estimatedMs/1000*0.35)));let remaining=minWait;debugLog('info','POLLING','Attente initiale '+remaining+'s pour '+videoId);while(remaining>0){if(state.stopRequested)throw new Error('Arrêt demandé');await ensureWakeLockActive();onProgress('File vidéo — '+remaining+'s');await sleep(1000);remaining--}let attempt=0;let idleRounds=0;while(attempt<VIDEO_MAX_POLL_ATTEMPTS){if(state.stopRequested)throw new Error('Arrêt demandé');attempt++;const url=POLL_BASE+'?video_id='+encodeURIComponent(videoId)+'&model_name='+encodeURIComponent(MODEL_VIDEO);let res;try{res=await apiFetch(url,{method:'GET',headers:{'Authorization':'Bearer '+getApiKey()}},'Polling','video')}catch(e){debugLog('warn','POLLING','Erreur transitoire : '+e.message);await sleep(Math.min(90000,15000+attempt*1500));continue}let d;try{d=await res.json()}catch(e){debugLog('warn','POLLING','Réponse non JSON, reprise');await sleep(Math.min(60000,10000+attempt*1000));continue}const status=String(d.status||'unknown').toLowerCase();const progress=Number(d.progress||0);onProgress('Création — '+progress+'%');debugLog('response','POLL #'+attempt,'Statut : '+status+' ('+progress+'%)');if(status==='completed'||status==='succeeded'||status==='done'){const videoUrl=d.url||(d.metadata&&d.metadata.url)||(d.output&&d.output.url);if(!videoUrl)throw new Error("Terminé mais pas d'URL");debugLog('success','POLLING','Terminé après '+attempt+' polls');return videoUrl}if(status==='failed'||status==='error'||status==='cancelled'){throw new Error('Échec définitif ('+status+')')}idleRounds++;const wait=attempt<5?8:Math.min(30,10+Math.floor(attempt/5)*3);onProgress('File vidéo — nouvelle vérification dans '+wait+'s');await sleep(wait*1000);if(idleRounds>VIDEO_MAX_POLL_ATTEMPTS)break}throw new Error('Délai maximal de polling dépassé') }

