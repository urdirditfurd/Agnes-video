ryAfter>0?retryAfter:Math.min(180,75+attempt*12);debugLog('warn','VIDEO_QUEUE','Queue vidéo saturée — nouvelle tentative dans '+wait+'s');setStatus('File vidéo Agnes saturée — nouvelle tentative dans '+wait+'s');await sleep(wait*1000);continue}if(res.status===429){const wait=retryAfter>0?retryAfter:Math.min(kind==='video'?180:120,kind==='video'?60+attempt*8:10+attempt*12);if(kind==='image')createImageIntervalMs=Math.min(IMAGE_INTERVAL_MAX,createImageIntervalMs+1000);if(kind==='video')createVideoIntervalMs=Math.min(VIDEO_INTERVAL_MAX,createVideoIntervalMs+6000);debugLog('warn','RATELIMIT','429 — attente '+wait+'s');setStatus('Limite API — nouvelle tentative dans '+wait+'s');await sleep(wait*1000);continue}if([500,502,503,504,520].includes(res.status)){const wait=Math.min(kind==='video'?180:60,kind==='video'?20+attempt*10:5+attempt*5);if(res.status===503&&kind==='video')debugLog('warn','SERVICE','503 — service vidéo occupé, conservation du processus');else debugLog('warn','SERVICE','HTTP '+res.status+' — attente '+wait+'s');setStatus('Service occupé — nouvelle tentative dans '+wait+'s');await sleep(wait*1000);continue}return res}catch(e){if(e.message==='Arrêt demandé')throw e;const wait=Math.min(kind==='video'?120:45,kind==='video'?10+attempt*8:3+attempt*4);debugLog('warn','NETWORK',e.message+' — retry dans '+wait+'s');setStatus('Connexion instable — reprise dans '+wait+'s');await sleep(wait*1000)}}throw new Error('Tentatives épuisées pour '+label+' après '+maxAttempts+' essais')}

function escapeControlCharsInStrings(text){let result='';let inString=false;let escape=false;for(let i=0;i<text.length;i++){const ch=text[i];if(escape){result+=ch;escape=false;continue}if(ch==='\\'){result+=ch;escape=true;continue}if(ch==='"'){inString=!inString;result+=ch;continue}if(inString){if(ch==='\n'){result+='\\n';continue}if(ch==='\r'){result+='\\r';continue}if(ch==='\t'){result+='\\t';continue}const code=ch.charCodeAt(0);if(code<32){result+='\\u'+code.toString(16).padStart(4,'0');continue}}result+=ch}return result}
function balanceJson(text){let openBraces=0,openBrackets=0,inString=false,escape=false;for(let i=0;i<text.length;i++){const ch=text[i];if(escape){escape=false;continue}if(ch==='\\'){escape=true;continue}if(ch==='"'){inString=!inString;continue}if(inString)continue;if(ch==='{')openBraces++;else if(ch==='}')openBraces--;else if(ch==='[')openBrackets++;else if(ch===']')openBrackets--}let result=text;if(inString)result+='"';while(openBrackets>0){result+=']';openBrackets--}while(openBraces>0){result+='}';openBraces--}return result}

