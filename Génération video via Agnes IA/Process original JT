function createRateLimitedQueue(maxConcurrent,minIntervalMs){let running=0;let lastStart=0;const queue=[];let resolveIdle=null;function tryNext(){if(running>=maxConcurrent)return;if(queue.length===0){if(running===0&&resolveIdle){resolveIdle();resolveIdle=null}return}const now=Date.now();const wait=Math.max(0,lastStart+minIntervalMs-now);if(wait>0){setTimeout(tryNext,wait);return}const task=queue.shift();running++;lastStart=Date.now();task().finally(()=>{running--;setTimeout(tryNext,0)})}return{add(fn){return new Promise((resolve,reject)=>{queue.push(()=>fn().then(resolve,reject));setTimeout(tryNext,0)})},idle(){return new Promise(r=>{if(running===0&&queue.length===0)return r();resolveIdle=r})}}}

function setStatus(text){const bar=document.getElementById('status-bar');const txt=document.getElementById('status-text');if(!bar||!txt)return;if(text){bar.classList.add('visible');txt.textContent=text}else bar.classList.remove('visible')}
function setPhase(phase,detail,eta){const bar=document.getElementById('phase-bar');if(bar)bar.classList.add('visible');document.querySelectorAll('.phase-step').forEach(el=>{el.classList.remove('active','done');const order=['text','dialogue','images','videos','done'];const curIdx=order.indexOf(phase);const elIdx=order.indexOf(el.dataset.phase);if(elIdx<curIdx)el.classList.add('done');else if(elIdx===curIdx)el.classList.add('active')});const d=document.getElementById('phase-detail');const e=document.getElementById('phase-eta');if(d)d.innerHTML=detail||'';if(e)e.textContent=eta||''}

function addMediaLogEntry(kind,url){const log=document.getElementById('media-log');if(!log)return;const empty=log.querySelector('div[style]');if(empty)empty.remove();const time=new Date().toLocaleTimeString('fr-FR',{hour12:false});const el=document.createElement('div');el.className='media-log-entry';const displayUrl=url.length>120?url.slice(0,120)+'…':url;el.innerHTML='<span style="font-size:.58rem;padding:.15rem .4rem;border-radius:4px;text-transform:uppercase;font-weight:700;background:rgba(143,173,136,.15);color:var(--acc);">'+kind+'</span><span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--acc3);font-size:.66rem;"><a href="'+esc(url)+'" target="_blank" rel="noopener" style="color:var(--acc3);text-decoration:none;">'+esc(displayUrl)+'</a></span><span style="color:var(--faint);font-size:.62rem;">'+time+'</span>';log.appendChild(el);const countEl=document.getElementById('medialog-count');if(countEl)countEl.textContent=String(log.querySelectorAll('.media-log-entry').length)}

// 🦦 MODIFICATION LOFI : pipeline simplifié en 4 étapes
async function startLofi(){if(state.isRunning)return;if(!getApiKey()){showToast('Ajoutez votre clé API','error');document.getElementById('api-key-input').focus();return}const desc=document.getElementById('user-description').value.trim();if(desc.length<4){showToast('Décrivez une scène (min. 4 caractères)','error');return}
state.isRunning=true;state.stopRequested=false;state.expansion=null;state.rawExpansionResponse='';state.imageUrl=null;state.videoUrl=null;state.userDescription=desc;
document.getElementById('lofi-panel').classList.remove('visible');
document.getElementById('lofi-title').textContent='—';
document.getElementById('lofi-meta').textContent='Généré par Lofi Capybara Studio';
document.getElementById('lofi-image-preview').style.display='none';
document.getElementById('lofi-image').src='';
document.getElementById('lofi-video-container').innerHTML='<div class="lofi-video-placeholder" id="lofi-video-placeholder">🦦 La vidéo lofi apparaîtra ici…</div>';
document.getElementById('lofi-prompt-display').innerHTML='';
document.getElementById('download-btn').style.display='none';
document.getElementById('raw-expansion').textContent='';
document.getElementById('media-log').innerHTML='<div style="font-size:.72rem;color:var(--dim);font-family:var(--fm);">Les URLs apparaîtront ici.</div>';
document.getElementById('medialog-count').textContent='0';
document.getElementById('stop-btn').classList.add('visible');
document.getElementById('lofi-btn').disabled=true;
document.getElementById('phase-bar').classList.add('visible');
await ensureWakeLockActive();
const totalStart=Date.now();
debugLog('state','START','════════════════════════════════════════');
debugLog('state','START','DÉMARRAGE LOFI CAPYBARA');
debugLog('state','CONFIG','Description : '+desc);
debugLog('state','CONFIG','Ambiance : '+MOODS[state.mood].label);
debugLog('state','CONFIG','Durée : '+state.durationSeconds+'s · Format : '+state.format);
try{
// 🦦 MODIFICATION LOFI : Phase 2 — enrichissement IA
setPhase('dialogue','🧠 Enrichissement de votre idée par l\'IA…','');
const exp=await generateExpansion(desc,state.mood);state.expansion=exp;
document.getElementById('lofi-title').textContent=exp.title;
document.getElementById('lofi-meta').textContent='🦦 Capybara Lofi · '+MOODS[state.mood].label+' · '+state.durationSeconds+'s';
document.getElementById('lofi-panel').classList.add('visible');
document.getElementById('lofi-prompt-display').innerHTML='<span class="hl">✨ Scène :</span> '+esc(exp.image_prompt.slice(0,300))+(exp.image_prompt.length>300?'…':'');
// 🦦 MODIFICATION LOFI : Phase 3 — image unique
setPhase('images','🎨 Création de l\'image Ghibli…','');
setStatus('Création de l\'image Ghibli avec la capybara…');
const imgPrompt=buildLofiImagePrompt(exp);
try{const imgUrl=await generateImage(imgPrompt,state.format);state.imageUrl=imgUrl;addMediaLogEntry('image',imgUrl);const previewEl=document.getElementById('lofi-image-preview');const imgEl=document.getElementById('lofi-image');if(previewEl&&imgEl){imgEl.src=imgUrl;previewEl.style.display='block'}debugLog('success','IMAGE','Image générée')}catch(e){debugLog('error','IMAGE','Échec : '+e.message);throw e}
// 🦦 MODIFICATION LOFI : Phase 4 — vidéo unique
setPhase('videos','🎬 Création de la vidéo lofi au mouvement lent…','');
setStatus('Création de la vidéo lofi (mouvement lent)…');
createVideoIntervalMs=VIDEO_INTERVAL_SAFE;videoAttemptsSinceLastError=0;
const vidPrompt=buildLofiVideoPrompt(exp);
try{
const videoId=await generateVideo(state.imageUrl,vidPrompt,state.format);
debugLog('success','VIDÉO','Tâche : '+videoId);
const videoUrl=await pollVideo(videoId,(prog)=>{setStatus('Vidéo lofi — '+prog)});
const elapsed=Date.now()-totalStart;recordGenerationTime('video',elapsed);
state.videoUrl=videoUrl;addMediaLogEntry('video',videoUrl);
const container=document.getElementById('lofi-video-container');
container.innerHTML='';
const v=document.createElement('video');v.controls=true;v.preload='metadata';v.playsInline=true;v.loop=true;v.src=videoUrl;container.appendChild(v);
document.getElementById('download-btn').style.display='block';
document.getElementById('download-btn').onclick=()=>{const a=document.createElement('a');a.href=videoUrl;a.download=(exp.title||'lofi-capybara').replace(/[^a-z0-9]/gi,'_')+'.mp4';a.target='_blank';a.rel='noopener';document.body.appendChild(a);a.click();document.body.removeChild(a)};
debugLog('success','VIDÉO','Terminée en '+(elapsed/1000).toFixed(1)+'s')
}catch(e){debugLog('error','VIDÉO','Échec : '+e.message);throw e}
setPhase('done','✦ Vidéo Lofi prête ✦','')
}catch(e){debugLog('error','GLOBAL',e.message);setStatus('Erreur : '+e.message)}
const totalElapsed=(Date.now()-totalStart)/1000;
const success=!!state.videoUrl;
const summary=state.stopRequested?'Arrêté':success?'✦ Vidéo Lofi prête en '+formatEta(totalElapsed)+' ✦':'Échec de génération';
debugLog('state','FIN',summary);
debugLog('state','FIN','════════════════════════════════════════');
setStatus(summary);
await sleep(4500);setStatus(null);
state.isRunning=false;state.stopRequested=false;
document.getElementById('stop-btn').classList.remove('visible');
updateLofiButton();
if(success)showToast('🦦 Vidéo lofi générée !','success',4000);else showToast('Génération échouée','error',3500);
await deactivateWakeLock()}

