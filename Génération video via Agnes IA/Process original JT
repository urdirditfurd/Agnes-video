try{const saved=localStorage.getItem(WAKE_LOCK_PREF);wakeLockEnabled=saved==='1'}catch(e){}
if(wakeLockEnabled)activateWakeLock();
updateApiPanel();updateTimingDisplay();updateLofiButton();
const savedKey=getApiKey();if(savedKey)document.getElementById('api-key-input').value=savedKey;
debugLog('success','INIT','Lofi Capybara Studio prêt 🦦');
debugLog('info','INIT','Pipeline : DESCRIPTION → ENRICHISSEMENT IA → IMAGE GHIBLI → VIDÉO LOFI');
debugLog('info','INIT','Modèles : '+MODEL_TEXT+' / '+MODEL_IMAGE+' / '+MODEL_VIDEO);
debugLog('info','INIT','Contrainte : capybara mignonne + mouvement lent + style Ghibli watercolor');
})();
</script>
