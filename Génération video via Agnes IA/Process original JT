function extractJson(text){if(!text)return null;let c=text.trim();const fm=c.match(/```(?:json)?\s*([\s\S]*?)```/);if(fm)c=fm[1].trim();const fb=c.indexOf('{');if(fb<0){debugLog('error','PARSE','Aucun { trouvé');return null}c=c.slice(fb);try{const r=JSON.parse(c);debugLog('success','PARSE','Stratégie 1 OK');return r}catch(e1){debugLog('warn','PARSE','S1 échouée')}try{const r=JSON.parse(escapeControlCharsInStrings(c));debugLog('success','PARSE','Stratégie 2 OK');return r}catch(e2){debugLog('warn','PARSE','S2 échouée')}try{const lb=c.lastIndexOf('}');if(lb>0){const r=JSON.parse(escapeControlCharsInStrings(c.slice(0,lb+1)));debugLog('success','PARSE','Stratégie 3 OK');return r}}catch(e3){debugLog('warn','PARSE','S3 échouée')}try{const r=JSON.parse(balanceJson(escapeControlCharsInStrings(c)));debugLog('success','PARSE','Stratégie 4 OK');return r}catch(e4){debugLog('warn','PARSE','S4 échouée')}try{const s=salvageExpansion(c);if(s&&(s.image_prompt||s.video_motion_prompt)){debugLog('success','PARSE','Stratégie 5 (regex)');return s}}catch(e5){debugLog('error','PARSE','S5 échouée')}debugLog('error','PARSE','Aucune stratégie n\'a fonctionné');return null}

