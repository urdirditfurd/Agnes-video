<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Lofi Capybara Studio — Ambiances apaisantes</title>
<style>
/* 🦦 MODIFICATION LOFI : thème apaisant nature — verts sauge, beiges, bleus crépusculaires */
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
:root{
--bg:#e8e4dc;--bg2:#f2efe9;--bg3:#dcd8d0;
--panel:#f7f4ee;--border:#d0ccc4;
--ink:#3d3d35;--dim:#7a786e;--faint:#b0ada3;
--acc:#8fad88;--acc2:#c4a882;--acc3:#7a9eb8;
--ok:#7a9d6e;--err:#c47a6a;--warn:#c4a840;
--r:16px;--fs:-apple-system,BlinkMacSystemFont,'Helvetica Neue',Arial,sans-serif;
--fm:ui-monospace,'SF Mono',Menlo,monospace;
}
html,body{background:var(--bg)}
body{font-family:var(--fs);background:linear-gradient(135deg,#e8e4dc 0%,#e0dcd4 100%);color:var(--ink);min-height:100vh;padding:1.5rem 1rem 24rem;font-size:15px;line-height:1.55;max-width:900px;margin:0 auto}
header{margin-bottom:2rem;text-align:center;padding:1.5rem 0 1.5rem;position:relative}
header::after{content:'';position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:180px;height:2px;background:linear-gradient(90deg,transparent,var(--acc),transparent);opacity:.6;border-radius:2px}
h1{font-size:2.2rem;font-weight:300;margin-bottom:.5rem;background:linear-gradient(135deg,var(--acc),var(--acc2));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;letter-spacing:.02em}
.subtitle{font-size:.92rem;color:var(--dim);font-style:italic}
.capy-badge{display:inline-flex;align-items:center;gap:.4rem;font-size:.75rem;padding:.35rem .9rem;border-radius:999px;background:rgba(143,173,136,.15);border:1px solid var(--acc);color:var(--ink);margin-top:.8rem}
.toast{position:fixed;top:1.5rem;left:50%;transform:translateX(-50%) translateY(-120px);background:var(--bg3);color:var(--ink);border:1px solid var(--border);border-left:4px solid var(--acc);padding:.9rem 1.5rem;border-radius:var(--r);font-size:.85rem;box-shadow:0 8px 32px rgba(60,60,50,.15);z-index:1000;opacity:0;transition:transform .35s cubic-bezier(.2,.9,.3,1.2),opacity .35s;max-width:90vw;text-align:center;display:flex;align-items:center;gap:.6rem}
.toast.visible{transform:translateX(-50%) translateY(0);opacity:1}
.toast.success{border-left-color:var(--ok)}.toast.error{border-left-color:var(--err)}.toast.warn{border-left-color:var(--warn)}
.banner{background:var(--panel);border:1px solid var(--border);border-left:4px solid var(--acc);padding:1.1rem 1.3rem;border-radius:var(--r);font-size:.82rem;color:var(--dim);margin-bottom:1.2rem;line-height:1.65;box-shadow:0 2px 12px rgba(60,60,50,.06)}
.banner strong{color:var(--ink)}.banner .hl{color:var(--acc);font-weight:600}
.panel{background:var(--panel);border:1px solid var(--border);border-radius:var(--r);padding:1.3rem 1.4rem;margin-bottom:1rem;box-shadow:0 2px 12px rgba(60,60,50,.06)}
.panel.ok{box-shadow:inset 4px 0 0 var(--ok),0 2px 12px rgba(60,60,50,.06)}
input[type=password],input[type=text],textarea{width:100%;padding:.9rem 1.1rem;border-radius:12px;border:1px solid var(--border);background:var(--bg2);color:var(--ink);font-family:var(--fs);font-size:.9rem;margin-bottom:.7rem;transition:border-color .2s}
textarea{resize:vertical;min-height:80px;line-height:1.5}
input:focus,textarea:focus{outline:none;border-color:var(--acc);box-shadow:0 0 0 3px rgba(143,173,136,.15)}
.btn{width:100%;padding:.9rem 1.3rem;border-radius:12px;border:1px solid var(--border);background:var(--bg2);color:var(--ink);font-size:.85rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;margin-bottom:.7rem;transition:all .2s}
.btn:hover{background:var(--bg3);transform:translateY(-1px)}
.btn-primary{border:none;background:linear-gradient(135deg,var(--acc),#7a9d6e);color:#fff;font-size:1rem;padding:1.2rem;letter-spacing:.12em;box-shadow:0 4px 16px rgba(143,173,136,.3)}
.btn-primary:hover{box-shadow:0 6px 20px rgba(143,173,136,.4)}
.btn-primary:disabled{opacity:.4;cursor:not-allowed;transform:none;box-shadow:none}
.btn-stop{border:1px solid var(--err);color:var(--err);background:transparent;display:none}
.btn-stop.visible{display:block}
.btn-download{border:1px solid var(--acc3);color:var(--acc3);background:transparent;margin-top:.8rem}
.btn-download:hover{background:rgba(122,158,184,.1)}
.status{font-size:.75rem;padding:.65rem .95rem;border-radius:10px;margin-bottom:.5rem;display:flex;align-items:center;gap:.6rem;background:var(--bg2);color:var(--dim);border:1px solid var(--border)}
.status.ok{background:rgba(122,157,110,.1);color:var(--ok);border-color:rgba(122,157,110,.3)}
.dot{width:7px;height:7px;border-radius:50%;background:var(--faint);flex-shrink:0}
.status.ok .dot{background:var(--ok);box-shadow:0 0 8px var(--ok)}
.hint{font-size:.72rem;color:var(--dim);margin-top:.5rem;line-height:1.5}
.hint a{color:var(--acc);text-decoration:none;font-weight:600}
.stat{font-size:.72rem;color:var(--dim);margin-top:.6rem;padding:.55rem .8rem;background:var(--bg2);border-radius:10px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:.3rem;border:1px solid var(--border);font-family:var(--fm)}
.section{background:var(--panel);border:1px solid var(--border);border-radius:var(--r);margin-bottom:1rem;overflow:hidden;box-shadow:0 2px 12px rgba(60,60,50,.06)}
.section-header{padding:1rem 1.3rem;cursor:pointer;user-select:none;display:flex;justify-content:space-between;align-items:center}
.section-title{font-size:.82rem;text-transform:uppercase;letter-spacing:.18em;color:var(--ink);font-weight:600;display:flex;align-items:center;gap:.6rem}
.badge{display:inline-block;padding:.18rem .6rem;background:rgba(143,173,136,.12);color:var(--acc);border:1px solid rgba(143,173,136,.3);border-radius:6px;font-size:.6rem;letter-spacing:.12em;font-weight:600}
.chevron{font-size:.7rem;color:var(--faint);transition:transform .3s}
.section.open .chevron{transform:rotate(180deg);color:var(--acc)}
.section-body{max-height:0;overflow:hidden;transition:max-height .4s ease}
.section.open .section-body{max-height:8000px}
.section-content{padding:0 1.3rem 1.3rem}
.row{margin-bottom:1rem}
.label{display:block;font-size:.72rem;color:var(--dim);margin-bottom:.5rem;text-transform:uppercase;letter-spacing:.12em;font-weight:600}
select{width:100%;padding:.85rem 1rem;border-radius:12px;border:1px solid var(--border);background:var(--bg2);color:var(--ink);font-size:.88rem;appearance:none;background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='6' viewBox='0 0 10 6'><path fill='%238fad88' d='M0 0l5 6 5-6z'/></svg>");background-repeat:no-repeat;background-position:right 1rem center;background-size:10px;transition:border-color .2s}
select:focus{outline:none;border-color:var(--acc);box-shadow:0 0 0 3px rgba(143,173,136,.15)}
select option{background:var(--bg2);color:var(--ink)}
.phase-bar{background:var(--panel);border:1px solid var(--border);border-left:4px solid var(--acc);border-radius:var(--r);padding:1rem 1.1rem;margin-bottom:1rem;display:none;box-shadow:0 2px 12px rgba(60,60,50,.06)}
.phase-bar.visible{display:block}
.phase-steps{display:flex;gap:.5rem;margin-bottom:.8rem;flex-wrap:wrap}
.phase-step{flex:1;min-width:60px;padding:.55rem .4rem;border-radius:10px;background:var(--bg2);border:1px solid var(--border);font-size:.55rem;text-transform:uppercase;letter-spacing:.05em;text-align:center;color:var(--faint);font-weight:600;transition:all .3s}
.phase-step.active{color:#fff;border-color:var(--acc);background:var(--acc);box-shadow:0 2px 8px rgba(143,173,136,.3)}
.phase-step.done{color:var(--ok);border-color:rgba(122,157,110,.3);background:rgba(122,157,110,.1)}
.phase-info{font-size:.75rem;font-family:var(--fm);color:var(--dim);display:flex;justify-content:space-between;flex-wrap:wrap;gap:.4rem}
/* 🦦 MODIFICATION LOFI : simplifié — un seul lecteur vidéo centré */
.lofi-panel{display:none;margin-top:1.5rem}
.lofi-panel.visible{display:block}
.lofi-card{background:var(--panel);border:1px solid var(--border);border-radius:var(--r);padding:1.5rem 1.4rem;margin-bottom:1rem;box-shadow:0 4px 24px rgba(60,60,50,.1)}
.lofi-title{font-size:1.5rem;color:var(--ink);margin-bottom:.5rem;text-align:center;font-weight:300;letter-spacing:.02em}
.lofi-meta{font-size:.72rem;color:var(--dim);text-align:center;letter-spacing:.12em;text-transform:uppercase;margin-bottom:1.2rem;font-family:var(--fm)}
.lofi-video-container{max-width:720px;margin:0 auto;border-radius:var(--r);overflow:hidden;border:1px solid var(--border);background:#000;box-shadow:0 4px 20px rgba(60,60,50,.15)}
.lofi-video-container video{width:100%;display:block;aspect-ratio:16/9;object-fit:cover;background:#000}
.lofi-video-placeholder{display:flex;align-items:center;justify-content:center;aspect-ratio:16/9;color:var(--faint);font-size:.8rem;font-family:var(--fm);background:var(--bg2);border:2px dashed var(--border)}
.lofi-prompt-display{font-size:.75rem;color:var(--dim);font-style:italic;text-align:center;margin-top:1rem;padding:.8rem 1rem;background:var(--bg2);border-radius:10px;line-height:1.5;max-width:720px;margin-left:auto;margin-right:auto}
.lofi-prompt-display .hl{color:var(--acc);font-weight:600;font-style:normal}
.lofi-image-preview{max-width:320px;margin:0 auto .8rem;border-radius:12px;overflow:hidden;border:1px solid var(--border);box-shadow:0 2px 12px rgba(60,60,50,.1)}
.lofi-image-preview img{width:100%;display:block;aspect-ratio:16/9;object-fit:cover}
.status-bar{position:fixed;bottom:0;left:0;right:0;background:var(--bg3);border-top:1px solid var(--border);color:var(--ink);padding:.9rem 1.2rem;font-size:.78rem;display:flex;align-items:center;gap:.7rem;transform:translateY(100%);transition:transform .35s cubic-bezier(.2,.9,.3,1);z-index:100;font-family:var(--fm);box-shadow:0 -4px 20px rgba(60,60,50,.1)}
.status-bar.visible{transform:translateY(0)}
.spinner{width:13px;height:13px;border:2px solid rgba(143,173,136,.2);border-top-color:var(--acc);border-radius:50%;animation:spin .8s linear infinite;flex-shrink:0}
@keyframes spin{to{transform:rotate(360deg)}}
.debug-panel{position:fixed;bottom:0;left:0;right:0;height:260px;background:#2a2a25;border-top:2px solid var(--acc);z-index:200;display:flex;flex-direction:column;font-family:var(--fm);box-shadow:0 -8px 32px rgba(60,60,50,.2);transition:height .3s ease}
.debug-panel.collapsed{height:36px}
.debug-header{display:flex;justify-content:space-between;align-items:center;padding:.55rem .9rem;background:linear-gradient(90deg,#22221e,#2a2a25);border-bottom:1px solid #3a3a32;flex-shrink:0;cursor:pointer;user-select:none}
.debug-title{font-size:.72rem;color:var(--acc);letter-spacing:.12em;text-transform:uppercase;font-weight:600;display:flex;align-items:center;gap:.5rem}
.debug-badge{font-size:.6rem;padding:.1rem .45rem;background:var(--acc);color:#2a2a25;border-radius:4px;font-weight:700}
.debug-actions{display:flex;gap:.3rem}
.debug-actions button{background:transparent;border:1px solid #3a3a32;color:#9a988e;font-size:.62rem;padding:.28rem .6rem;border-radius:6px;cursor:pointer;transition:all .2s}
.debug-actions button:hover{color:var(--acc);border-color:var(--acc)}
.debug-body{flex:1;overflow-y:auto;padding:.5rem .8rem 1rem;font-size:.72rem;line-height:1.45;color:#c8c6bc}
.debug-entry{margin-bottom:.3rem;padding:.28rem .45rem;border-left:2px solid transparent;border-radius:4px;word-break:break-word}
.debug-entry.info{border-left-color:#5a584e}
.debug-entry.success{border-left-color:var(--ok);background:rgba(122,157,110,.06)}
.debug-entry.warn{border-left-color:var(--warn);background:rgba(196,168,64,.06)}
.debug-entry.error{border-left-color:var(--err);background:rgba(196,122,106,.08);color:#e8a898}
.debug-entry.api{border-left-color:var(--acc)}
.debug-entry.response{border-left-color:var(--acc2)}
.debug-entry.state{border-left-color:var(--acc2)}
.debug-entry.ai{border-left-color:var(--acc)}
.debug-time{color:#5a584e;margin-right:.5rem;font-size:.65rem}
.debug-cat{color:var(--acc);font-weight:600;margin-right:.4rem;font-size:.65rem}
.debug-msg{color:#d8d6cc}
.debug-data{margin-top:.3rem;padding:.45rem .55rem;background:#1e1e1a;border:1px solid #3a3a32;border-radius:6px;font-size:.68rem;color:#b8d8a8;max-height:180px;overflow:auto;white-space:pre-wrap;word-break:break-all;line-height:1.4}
.hidden{display:none!important}
@media(max-width:480px){h1{font-size:1.9rem}body{padding-bottom:22rem}.debug-panel{height:220px}.phase-step{font-size:.48rem;padding:.4rem .2rem}}
</style>
</head>
<body>

<header>
<h1>Lofi Capybara Studio</h1>
<p class="subtitle">Ambiances vidéo apaisantes inspirées de Ghibli · Une capybara vous accompagne</p>
<div class="capy-badge">🦦 Capybara Lofi</div>
</header>

<div class="banner">
<strong>Comment ça marche :</strong> décrivez une scène apaisante en quelques mots (ex. <em>« maison japonaise dans une forêt de sapins sous la pluie »</em>). L'IA enrichit votre idée dans le style <strong class="hl">Studio Ghibli</strong> et ajoute toujours une <strong class="hl">capybara mignonne et apaisante</strong>. Une image puis une vidéo lofi au <strong class="hl">mouvement lent et bouclable</strong> sont générées.
</div>

<div class="panel" id="api-panel">
<input type="password" id="api-key-input" placeholder="Collez votre clé API Agnes ici (sk-...)" autocomplete="off" spellcheck="false">
<button type="button" class="btn" id="api-save-btn">Enregistrer la clé</button>
<div class="status" id="api-status-line"><span class="dot"></span><span id="api-status-text">Aucune clé API enregistrée</span></div>
<div class="hint">Clé gratuite sur <a href="https://platform.agnes-ai.com" target="_blank">platform.agnes-ai.com</a> → Settings → API Keys</div>
<div class="stat" id="stat-line"><span>🦦 Vitesse vidéo : <span id="stat-speed">en attente</span></span><span id="stat-samples">0 génération</span></div>
</div>

<!-- 🦦 MODIFICATION LOFI : zone de saisie utilisateur -->
<div class="panel">
<label class="label" style="font-size:.8rem;margin-bottom:.6rem;">Décrivez votre scène apaisante</label>
<textarea id="user-description" placeholder="Ex. : maison japonaise dans une forêt de sapins sous la pluie, lumière dorée du soir, feuilles qui tombent lentement…" rows="3"></textarea>
<div class="hint" style="margin-top:.3rem;">💡 Plus la scène est sensorielle (lumière, météo, moment de la journée), plus le résultat est poétique.</div>
</div>

<button type="button" class="btn btn-primary" id="lofi-btn" disabled>
🦦 Générer ma vidéo Lofi
<span style="display:block;font-size:.65rem;letter-spacing:.15em;color:rgba(255,255,255,.7);margin-top:.4rem;font-weight:400;text-transform:none;">Description → Enrichissement IA → Image Ghibli → Vidéo lofi</span>
</button>
<button type="button" class="btn btn-stop" id="stop-btn">⏹ Arrêter la génération</button>

<div class="phase-bar" id="phase-bar">
<div class="phase-steps">
<div class="phase-step" data-phase="text">1 · Idée</div>
<div class="phase-step" data-phase="dialogue">2 · Enrichissement IA</div>
<div class="phase-step" data-phase="images">3 · Image Ghibli</div>
<div class="phase-step" data-phase="videos">4 · Vidéo lofi</div>
<div class="phase-step" data-phase="done">5 · Prêt</div>
</div>
<div class="phase-info"><span id="phase-detail">En attente</span><span id="phase-eta"></span></div>
</div>

<!-- 🦦 MODIFICATION LOFI : réglages simplifiés -->
<div class="section open" id="section-settings">
<div class="section-header" data-toggle="section-settings"><span class="section-title">⚙️ Réglages</span><span class="chevron">▼</span></div>
<div class="section-body"><div class="section-content">
<div class="row">
<label class="label">Ambiance dominante</label>
<select id="mood-select">
<option value="rainy_forest" selected>🌧️ Forêt sous la pluie</option>
<option value="golden_sunset">🌅 Coucher de soleil doré</option>
<option value="cozy_room">🕯️ Intérieur douillet</option>
<option value="japanese_garden">🏯 Jardin japonais</option>
<option value="mountain_lake">🏔️ Lac de montagne</option>
<option value="autumn_leaves">🍂 Feuilles d'automne</option>
<option value="night_stars">🌌 Nuit étoilée</option>
<option value="ocean_breeze">🌊 Brise océane</option>
</select>
</div>
<div class="row">
<label class="label">Durée de la vidéo</label>
<select id="duration-select">
<option value="5" selected>5 secondes (boucle rapide)</option>
<option value="6">6 secondes</option>
<option value="8">8 secondes</option>
<option value="10">10 secondes (lofi profond)</option>
</select>
</div>
<div class="row">
<label class="label">Format de la vidéo</label>
<select id="format-select">
<option value="16:9" selected>16:9 paysage — ambiance lofi</option>
<option value="9:16">9:16 portrait — format short</option>
</select>
</div>
</div></div>
</div>

<!-- 🦦 MODIFICATION LOFI : résultat simplifié — lecteur vidéo centré -->
<div class="lofi-panel" id="lofi-panel">
<div class="lofi-card">
<div class="lofi-title" id="lofi-title">—</div>
<div class="lofi-meta" id="lofi-meta">Généré par Lofi Capybara Studio</div>
<div class="lofi-image-preview" id="lofi-image-preview" style="display:none;"><img id="lofi-image" src="" alt="Aperçu image"></div>
<div class="lofi-video-container" id="lofi-video-container">
<div class="lofi-video-placeholder" id="lofi-video-placeholder">🦦 La vidéo lofi apparaîtra ici…</div>
</div>
<div class="lofi-prompt-display" id="lofi-prompt-display"></div>
<button type="button" class="btn btn-download" id="download-btn" style="display:none;">⬇️ Télécharger la vidéo</button>
<span id="raw-expansion-toggle" style="font-size:.62rem;color:var(--acc);cursor:pointer;margin-top:.6rem;border-bottom:1px dotted var(--border);display:inline-block;">▸ Voir la réponse brute de l'expansion IA (JSON)</span>
<pre id="raw-expansion" style="margin-top:.6rem;padding:.7rem;background:#2a2a25;border:1px solid #3a3a32;border-radius:8px;font-family:var(--fm);font-size:.68rem;color:#b8d8a8;max-height:340px;overflow:auto;white-space:pre-wrap;word-break:break-all;line-height:1.45;display:none;"></pre>
</div>
</div>

<!-- 🦦 MODIFICATION LOFI : journal des médias conservé -->
<div class="section" id="section-medialog" style="margin-top:1.5rem;">
<div class="section-header" data-toggle="section-medialog"><span class="section-title">🗂️ Journal des médias générés <span class="badge" id="medialog-count">0</span></span><span class="chevron">▼</span></div>
<div class="section-body"><div class="section-content">
<div class="media-log" id="media-log">
<div style="font-size:.72rem;color:var(--dim);font-family:var(--fm);">Les URLs des images et vidéos apparaîtront ici au fur et à mesure.</div>
</div>
</div></div>
</div>

<div class="status-bar" id="status-bar"><div class="spinner"></div><span id="status-text">Préparation…</span></div>

<div class="toast" id="toast"><span id="toast-icon">✓</span><span id="toast-text">Message</span></div>

<div class="debug-panel" id="debug-panel">
<div class="debug-header" id="debug-header">
<div class="debug-title">🖥️ Console de débogage <span class="debug-badge" id="debug-count">0</span></div>
<div class="debug-actions">
<button type="button" id="debug-copy-btn">Copier</button>
<button type="button" id="debug-clear-btn">Effacer</button>
<button type="button" id="debug-collapse-btn">−</button>
</div>
</div>
<div class="debug-body" id="debug-body"></div>
</div>

<canvas id="noSleepCanvas" width="2" height="2"></canvas>
<video id="noSleepVideo" playsinline muted loop></video>

<script>
const API_BASE='https://apihub.agnes-ai.com/v1';
const POLL_BASE='https://apihub.agnes-ai.com/agnesapi';
const MODEL_TEXT='agnes-2.5-flash';
const MODEL_IMAGE='agnes-image-2.5-flash';
const MODEL_VIDEO='agnes-video-2.5-flash';

// 🦦 MODIFICATION LOFI : palettes Ghibli/lofi pastel (remplace les palettes saturées)
const MOODS={
rainy_forest:{label:'Forêt sous la pluie',desc:'a lush green forest under soft rain, misty atmosphere, warm lamplight glowing through wet leaves, wet earth and moss details'},
golden_sunset:{label:'Coucher de soleil doré',desc:'a golden hour sunset with warm amber light, long soft shadows, glowing dust motes in the air, nostalgic warmth'},
cozy_room:{label:'Intérieur douillet',desc:'a cozy wooden interior with warm candlelight, soft blankets, steaming tea, rain visible through a window, amber glow'},
japanese_garden:{label:'Jardin japonais',desc:'a serene Japanese garden with stone lanterns, koi pond, cherry blossoms, moss-covered rocks, soft diffused daylight'},
mountain_lake:{label:'Lac de montagne',desc:'a still mountain lake reflecting soft clouds, pine trees, gentle morning mist, cool blue and sage tones'},
autumn_leaves:{label:'Feuilles d\'automne',desc:'an autumn forest with falling orange and gold leaves, warm late afternoon light, soft breeze, rustic wooden path'},
night_stars:{label:'Nuit étoilée',desc:'a peaceful night with a starry sky, soft moonlight, silhouetted trees, gentle blue and violet tones, distant fireflies'},
ocean_breeze:{label:'Brise océane',desc:'a calm ocean shore with gentle waves, soft sea breeze, warm sand, pastel sky, distant seagulls, serene horizon'}
